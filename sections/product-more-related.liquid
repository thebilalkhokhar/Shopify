{{ 'product-more-related.css' | asset_url | stylesheet_tag }}

<section
  id="product-more-related-{{ section.id }}"
  class="product-more-related-section"
  style="    background-color: {{ section.settings.outer_bg | default: '#171008' }};"
  {{ section.shopify_attributes }}
>
  <div class="pmr-container">
    <!-- Cream Card with Dot Grid -->
    <div class="pmr-card">
      <!-- Header: Badge & Heading -->
      <div class="pmr-header">
        {%- if section.settings.badge_text != blank -%}
          <div class="pmr-badge-wrap">
            <span class="pmr-badge">{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pmr-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <!-- Related Products -->
      <div class="pmr-grid" id="pmrTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign linked_product = block.settings.product -%}
            {%- assign item_title = block.settings.title | default: linked_product.title -%}
            {%- assign item_url = block.settings.url -%}
            {%- if item_url == blank and linked_product != blank -%}
              {%- assign item_url = linked_product.url -%}
            {%- elsif item_url == blank and item_title != blank -%}
              {%- assign title_clean = item_title | downcase -%}
              {%- if title_clean contains 'dispenser' -%}
                {%- assign item_url = '/products/dispensers' -%}
              {%- elsif title_clean contains 'pvc' -%}
                {%- assign item_url = '/products/pvc-tape' -%}
              {%- elsif title_clean contains 'flat' -%}
                {%- assign item_url = '/products/flatback-tape' -%}
              {%- elsif title_clean contains 'freezer' or title_clean contains 'hi-tack' or title_clean contains 'hi tack' -%}
                {%- assign item_url = '/products/hi-tack-freezer-tape' -%}
              {%- elsif title_clean contains 'paper' -%}
                {%- assign item_url = '/products/paper-tape' -%}
              {%- elsif title_clean contains 'poly' -%}
                {%- assign item_url = '/products/polypropylene-tape' -%}
              {%- else -%}
                {%- assign item_url = '/products/' | append: item_title | handleize -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign item_handle = '' -%}
            {%- if linked_product != blank -%}
              {%- assign item_handle = linked_product.handle -%}
            {%- elsif item_url contains '/products/' -%}
              {%- assign item_handle = item_url | split: '/products/' | last | split: '?' | first | split: '/' | first -%}
            {%- elsif item_title != blank -%}
              {%- assign item_handle = item_title | handleize -%}
            {%- endif -%}

            {%- assign item_img = block.settings.image | default: linked_product.featured_image -%}
            {%- assign item_img_url = '' -%}
            {%- if item_img != blank -%}
              {%- assign item_img_url = item_img | image_url: width: 800 -%}
            {%- endif -%}

            <div
              class="pmr-item pmr-item-pool"
              data-handle="{{ item_handle }}"
              data-title="{{ item_title | escape }}"
              data-img="{{ item_img_url }}"
              data-price="{{ block.settings.price_text | default: linked_product.price | money | escape }}"
              data-url="{{ item_url | default: '#' }}"
              {% if linked_product != blank and linked_product.selected_or_first_available_variant != blank %}
                data-variant-id="{{ linked_product.selected_or_first_available_variant.id }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <a href="{{ item_url | default: '#' }}" class="pmr-item-link">
                <div class="pmr-image-box">
                  {%- if item_img != blank -%}
                    {{
                      item_img
                      | image_url: width: 600
                      | image_tag: class: 'pmr-image', loading: 'lazy', alt: item_title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'pmr-image' }}
                  {%- endif -%}

                  <div class="pmr-quick-view">
                    <span class="pmr-quick-view-btn">Quick View</span>
                  </div>
                </div>
                <div class="pmr-info">
                  {%- if item_title != blank -%}
                    <h3 class="pmr-title">{{ item_title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.price_text != blank -%}
                    <p class="pmr-price">{{ block.settings.price_text }}</p>
                  {%- elsif linked_product != blank -%}
                    <p class="pmr-price">
                      Starting at <strong>{{ linked_product.price | money }}</strong>
                    </p>
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="pmr-controls" aria-label="Related product navigation">
        <div class="pmr-progress-wrap" aria-hidden="true">
          <div class="pmr-progress-bar" id="pmrProgress-{{ section.id }}"></div>
        </div>
        <div class="pmr-nav-buttons">
          <button
            type="button"
            class="pmr-nav-button"
            id="pmrPrevious-{{ section.id }}"
            aria-label="Previous related products"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <button
            type="button"
            class="pmr-nav-button"
            id="pmrNext-{{ section.id }}"
            aria-label="Next related products"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.getElementById('pmrTrack-{{ section.id }}');
    const progress = document.getElementById('pmrProgress-{{ section.id }}');
    const previousButton = document.getElementById('pmrPrevious-{{ section.id }}');
    const nextButton = document.getElementById('pmrNext-{{ section.id }}');

    if (!track) return;

    // Detect current page product handle from pathname
    var rawPath = decodeURIComponent(window.location.pathname.toLowerCase());
    var currentHandle = '';
    if (rawPath.indexOf('/products/') !== -1) {
      currentHandle = rawPath.split('/products/')[1].split('/')[0].split('?')[0].trim().replace(/\s+/g, '-');
    }

    // Get all candidate items
    const poolItems = Array.from(track.querySelectorAll('.pmr-item-pool'));
    if (poolItems.length > 0) {
      // Filter out current product
      let availableItems = poolItems.filter(item => {
        const handle = (item.getAttribute('data-handle') || '').toLowerCase().trim();
        return handle !== currentHandle;
      });

      // If filtering excluded too many or handle was empty, fall back to poolItems
      if (availableItems.length < 3) {
        availableItems = poolItems;
      }

      // Fisher-Yates shuffle available items
      for (let i = availableItems.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = availableItems[i];
        availableItems[i] = availableItems[j];
        availableItems[j] = temp;
      }

      // Pick top 3 random products
      const selectedItems = availableItems.slice(0, 3);

      // Hide unselected items and display selected items in track
      poolItems.forEach(item => {
        if (selectedItems.indexOf(item) !== -1) {
          item.style.display = 'flex';
          track.appendChild(item); // Re-order in DOM according to shuffle
        } else {
          item.style.display = 'none';
        }
      });
    }

    if (!progress || !previousButton || !nextButton) return;

    const updateProgress = function () {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const scrollRatio = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
      progress.style.width = 30 + scrollRatio * 70 + '%';
      previousButton.disabled = maxScroll <= 0 || track.scrollLeft <= 1;
      nextButton.disabled = maxScroll <= 0 || track.scrollLeft >= maxScroll - 1;
    };

    const scrollToAdjacentProduct = function (direction) {
      const firstItem = track.querySelector('.pmr-item:not([style*="display: none"])');
      if (!firstItem) return;

      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap) || 0;
      track.scrollBy({
        left: direction * (firstItem.getBoundingClientRect().width + gap),
        behavior: 'smooth',
      });
    };

    previousButton.addEventListener('click', function () {
      scrollToAdjacentProduct(-1);
    });
    nextButton.addEventListener('click', function () {
      scrollToAdjacentProduct(1);
    });
    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
</script>

{% schema %}
{
  "name": "Product More Related",
  "settings": [
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer Background Color",
      "default": "#171008"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Goes with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "People also needed these."
    }
  ],
  "blocks": [
    {
      "type": "related_product",
      "name": "Related Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Product Title",
          "default": "PVC Tape"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Custom Price Text",
          "default": "Starting at $7.84 a roll"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product More Related",
      "blocks": [
        {
          "type": "related_product",
          "settings": {
            "image": "shopify://shop_images/pvc.webp",
            "title": "PVC Tape",
            "price_text": "Starting at $7.84 a roll"
          }
        },
        {
          "type": "related_product",
          "settings": {
            "image": "shopify://shop_images/flattape.webp",
            "title": "Flatback Tape",
            "price_text": "Starting at $7.12 a roll"
          }
        },
        {
          "type": "related_product",
          "settings": {
            "image": "shopify://shop_images/dispensers.webp",
            "title": "Dispensers",
            "price_text": "From $34 per unit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
