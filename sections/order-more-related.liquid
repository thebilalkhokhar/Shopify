{{ 'order-more-related.css' | asset_url | stylesheet_tag }}

<section
  id="order-more-related-{{ section.id }}"
  class="order-more-related-section"
  style="
    background-color: {{ section.settings.outer_bg | default: '#171008' }};
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    position: relative;
    left: 0;
  "
  {{ section.shopify_attributes }}
>
  <div class="omr-container">
    <!-- Cream Card with Dot Grid -->
    <div class="omr-card">
      <!-- Header: Badge & Heading -->
      <div class="omr-header">
        {%- if section.settings.badge_text != blank -%}
          <div class="omr-badge-wrap">
            <span class="omr-badge">{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="omr-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <!-- Related Products -->
      <div class="omr-grid" id="omrTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign linked_product = block.settings.product -%}
            {%- assign item_title = block.settings.title | default: linked_product.title -%}
            {%- assign item_url = block.settings.url -%}
            {%- if item_url == blank and linked_product != blank -%}
              {%- assign item_url = linked_product.url -%}
            {%- elsif item_url == blank and item_title != blank -%}
              {%- assign item_url = '/products/' | append: item_title | handleize -%}
            {%- endif -%}

            {%- assign item_img = block.settings.image | default: linked_product.featured_image -%}

            <a href="{{ item_url | default: '#' }}" class="omr-item" {{ block.shopify_attributes }}>
              <div class="omr-image-box">
                {%- if item_img != blank -%}
                  {{
                    item_img
                    | image_url: width: 600
                    | image_tag: class: 'omr-image', loading: 'lazy', alt: item_title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'omr-image' }}
                {%- endif -%}
              </div>

              <div class="omr-info">
                {%- if item_title != blank -%}
                  <h3 class="omr-title">{{ item_title }}</h3>
                {%- endif -%}

                {%- if block.settings.price_text != blank -%}
                  <p class="omr-price">{{ block.settings.price_text }}</p>
                {%- elsif linked_product != blank -%}
                  <p class="omr-price">
                    Starting at <strong>{{ linked_product.price | money }}</strong>
                  </p>
                {%- endif -%}

                {%- if block.settings.short_description != blank -%}
                  <p class="omr-desc">{{ block.settings.short_description }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default 3 Product Boxes if no blocks added -->
          <a href="/products/pvc-tape" class="omr-item">
            <div class="omr-image-box">
              <img
                src="{{ 'pvc.webp' | file_url }}"
                alt="PVC Tape"
                class="omr-image"
                width="600"
                height="auto"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://0ap41c-jc.myshopify.com/cdn/shop/files/pvc.webp';"
              >
            </div>
            <div class="omr-info">
              <h3 class="omr-title">PVC Tape</h3>
              <p class="omr-price">Starting at <strong>$7.84</strong> a roll</p>
              <p class="omr-desc">Heavy-duty carton sealing tape with silent release and superior tack.</p>
            </div>
          </a>

          <a href="/products/flatback-tape" class="omr-item">
            <div class="omr-image-box">
              <img
                src="{{ 'flattape.webp' | file_url }}"
                alt="Flatback Tape"
                class="omr-image"
                width="600"
                height="auto"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://0ap41c-jc.myshopify.com/cdn/shop/files/flattape.webp';"
              >
            </div>
            <div class="omr-info">
              <h3 class="omr-title">Flatback Tape</h3>
              <p class="omr-price">Starting at <strong>$7.12</strong> a roll</p>
              <p class="omr-desc">Strong Kraft paper tape designed for easy hand-tear and instant stickiness.</p>
            </div>
          </a>

          <a href="/products/dispensers" class="omr-item">
            <div class="omr-image-box">
              <img
                src="{{ 'dispensers.webp' | file_url }}"
                alt="Dispensers"
                class="omr-image"
                width="600"
                height="auto"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://0ap41c-jc.myshopify.com/cdn/shop/files/dispensers.webp';"
              >
            </div>
            <div class="omr-info">
              <h3 class="omr-title">Dispensers</h3>
              <p class="omr-price">From <strong>$34</strong> per unit</p>
              <p class="omr-desc">Industrial water-activated dispensers and handheld tape guns for fast packaging.</p>
            </div>
          </a>
        {%- endif -%}
      </div>

      <div class="omr-controls" aria-label="Related product navigation">
        <div class="omr-progress-wrap" aria-hidden="true">
          <div class="omr-progress-bar" id="omrProgress-{{ section.id }}"></div>
        </div>
        <div class="omr-nav-buttons">
          <button
            type="button"
            class="omr-nav-button"
            id="omrPrevious-{{ section.id }}"
            aria-label="Previous related products"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </button>
          <button
            type="button"
            class="omr-nav-button"
            id="omrNext-{{ section.id }}"
            aria-label="Next related products"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.getElementById('omrTrack-{{ section.id }}');
    const progress = document.getElementById('omrProgress-{{ section.id }}');
    const previousButton = document.getElementById('omrPrevious-{{ section.id }}');
    const nextButton = document.getElementById('omrNext-{{ section.id }}');

    if (!track || !progress || !previousButton || !nextButton) return;

    const updateProgress = function () {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const scrollRatio = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
      progress.style.width = 30 + scrollRatio * 70 + '%';
      previousButton.disabled = maxScroll <= 0 || track.scrollLeft <= 1;
      nextButton.disabled = maxScroll <= 0 || track.scrollLeft >= maxScroll - 1;
    };

    const scrollToAdjacentProduct = function (direction) {
      const firstItem = track.querySelector('.omr-item');
      if (!firstItem) return;

      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap) || 0;
      track.scrollBy({
        left: direction * (firstItem.getBoundingClientRect().width + gap),
        behavior: 'smooth',
      });
    };

    previousButton.addEventListener('click', function () {
      scrollToAdjacentProduct(-1);
    });
    nextButton.addEventListener('click', function () {
      scrollToAdjacentProduct(1);
    });
    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
</script>

{% schema %}
{
  "name": "Order More Related",
  "settings": [
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer Background Color",
      "default": "#171008"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Goes with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "People also needed these."
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Related Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Shopify Product (Optional)",
          "info": "Auto-populates title, image and price if chosen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides product featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "PVC Tape"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price Text",
          "default": "Starting at $7.84 a roll"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "Short Description",
          "default": "Heavy-duty carton sealing tape with silent release and superior adhesion.",
          "info": "Displayed below the product price"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Order More Related",
      "blocks": [
        {
          "type": "product_item",
          "settings": {
            "title": "PVC Tape",
            "price_text": "Starting at $7.84 a roll",
            "short_description": "Heavy-duty carton sealing tape with silent release and superior adhesion."
          }
        },
        {
          "type": "product_item",
          "settings": {
            "title": "Flatback Tape",
            "price_text": "Starting at $9.20 a roll",
            "short_description": "Strong Kraft paper tape designed for easy hand-tear and fast tabbing."
          }
        },
        {
          "type": "product_item",
          "settings": {
            "title": "Tape Dispensers",
            "price_text": "From $34 per unit",
            "short_description": "Industrial water-activated dispensers and tape guns for fast packaging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
