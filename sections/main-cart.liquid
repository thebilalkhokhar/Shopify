{{ 'main-cart.css' | asset_url | stylesheet_tag }}

<div class="tapefox-cart-page" id="TapeFoxCartRoot" {{ section.shopify_attributes }}>
  <div class="tf-cart-container">
    
    <!-- Breadcrumbs -->
    <nav class="tf-cart-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      <span>Cart</span>
    </nav>

    <!-- Page Heading -->
    <h1 class="tf-cart-heading">{{ section.settings.heading | default: 'Your cart' }}</h1>

    {% if cart.item_count > 0 %}
      <div class="tf-cart-layout" id="tfCartLayout">
        
        <!-- LEFT: Cart Items Stack -->
        <div class="tf-cart-items-wrap" id="tfCartItemsWrap">
          {% for item in cart.items %}
            {%- assign item_title_lower = item.product.title | downcase -%}
            {%- assign rolls_count = item.properties['Cases'] | default: 5 | times: 8 -%}
            {%- assign per_roll_calc = item.final_line_price | divided_by: rolls_count -%}

            <div class="tf-cart-card" data-key="{{ item.key }}" data-line="{{ forloop.index }}">
              
              <!-- Card Top Section -->
              <div class="tf-cart-card-main">
                <!-- Thumbnail Yellow Box -->
                <div class="tf-cart-img-box">
                  {%- assign item_image = item.image | default: item.product.featured_image -%}
                  {%- if item_image != blank -%}
                    {{
                      item_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        alt: item.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>

                <!-- Product Info & Specs -->
                <div class="tf-cart-info">
                  <div class="tf-cart-eyebrow">{{ section.settings.eyebrow | default: 'Custom printed' }}</div>
                  <h2 class="tf-cart-title">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h2>

                  <!-- Specs Row (Dynamically populated from item.properties) -->
                  <div class="tf-cart-specs">
                    <!-- Size -->
                    <div class="tf-spec-item">
                      <span class="tf-spec-label">Size</span>
                      <span class="tf-spec-val">
                        {{ item.properties['Width'] | default: '3 inch' }} x {{ item.properties['Length'] | default: '375 feet' }}
                      </span>
                    </div>

                    <!-- Tape color -->
                    <div class="tf-spec-item">
                      <span class="tf-spec-label">Tape color</span>
                      <span class="tf-spec-val">{{ item.properties['Tape Color'] | default: 'Tan/Kraft' }}</span>
                    </div>

                    <!-- Ink -->
                    <div class="tf-spec-item">
                      <span class="tf-spec-label">Ink</span>
                      <span class="tf-spec-val">
                        {{ item.properties['Inks'] | default: 'One ink' }}
                        <span class="tf-color-dots">
                          {%- assign raw_ink_colors = item.properties['Ink Color'] | default: 'Blue' -%}
                          {%- assign color_list = raw_ink_colors | split: ',' -%}
                          {% for col in color_list %}
                            {%- assign clean_col = col | strip | downcase -%}
                            {% if clean_col == 'white' %}
                              <span class="tf-dot tf-dot--white" title="White"></span>
                            {% elsif clean_col == 'black' %}
                              <span class="tf-dot tf-dot--black" title="Black"></span>
                            {% elsif clean_col == 'blue' %}
                              <span class="tf-dot tf-dot--blue" title="Blue"></span>
                            {% elsif clean_col == 'red' %}
                              <span class="tf-dot tf-dot--red" title="Red"></span>
                            {% elsif clean_col == 'green' %}
                              <span class="tf-dot tf-dot--green" title="Green"></span>
                            {% elsif clean_col == 'orange' %}
                              <span class="tf-dot tf-dot--orange" title="Orange"></span>
                            {% elsif clean_col == 'yellow' %}
                              <span class="tf-dot tf-dot--yellow" title="Yellow"></span>
                            {% elsif clean_col == 'brown' %}
                              <span class="tf-dot tf-dot--brown" title="Brown"></span>
                            {% elsif clean_col == 'grey' or clean_col == 'gray' %}
                              <span class="tf-dot tf-dot--grey" title="Grey"></span>
                            {% else %}
                              <span class="tf-dot tf-dot--blue" title="{{ col | strip }}"></span>
                            {% endif %}
                          {% endfor %}
                        </span>
                      </span>
                    </div>

                    <!-- Coverage -->
                    <div class="tf-spec-item">
                      <span class="tf-spec-label">Coverage</span>
                      <span class="tf-spec-val">{{ item.properties['Coverage'] | default: 'Standard' }}</span>
                    </div>

                    <!-- Rolls -->
                    <div class="tf-spec-item">
                      <span class="tf-spec-label">Rolls</span>
                      <span class="tf-spec-val">{{ item.properties['Rolls'] | default: rolls_count | default: 40 }}</span>
                    </div>
                  </div>
                </div>

                <!-- Top Right Item Price -->
                <div class="tf-cart-price-block">
                  <div class="tf-cart-item-total">
                    {% if item.final_line_price > 0 %}
                      {{ item.final_line_price | money }}
                    {% elsif item.properties['Total Price'] != blank %}
                      {{ item.properties['Total Price'] }}
                    {% else %}
                      $464.63
                    {% endif %}
                  </div>
                  <div class="tf-cart-item-per-roll">
                    {% if per_roll_calc > 0 %}
                      {{ per_roll_calc | money }} a roll
                    {% elsif item.properties['Per Roll Price'] != blank %}
                      {{ item.properties['Per Roll Price'] }}
                    {% else %}
                      $11.62 a roll
                    {% endif %}
                  </div>
                </div>
              </div>

              <!-- Stepper & Action Links Row -->
              <div class="tf-cart-actions-row">
                <div class="tf-cart-stepper">
                  <button
                    type="button"
                    class="tf-cart-stepper-btn"
                    onclick="TapeFoxCart.changeQty('{{ item.key }}', {{ item.quantity | minus: 1 }})"
                    aria-label="Decrease quantity"
                  >−</button>
                  <span class="tf-cart-stepper-val">{{ item.quantity }}</span>
                  <button
                    type="button"
                    class="tf-cart-stepper-btn"
                    onclick="TapeFoxCart.changeQty('{{ item.key }}', {{ item.quantity | plus: 1 }})"
                    aria-label="Increase quantity"
                  >+</button>
                </div>

                <div class="tf-cart-links">
                  {%- capture edit_query -%}
                    edit_key={{ item.key | url_encode }}&width={{ item.properties['Width'] | url_encode }}&length={{ item.properties['Length'] | url_encode }}&tape_color={{ item.properties['Tape Color'] | url_encode }}&inks={{ item.properties['Inks'] | url_encode }}&ink_color={{ item.properties['Ink Color'] | url_encode }}&coverage={{ item.properties['Coverage'] | url_encode }}&printed_before={{ item.properties['Printed Before'] | url_encode }}&cases={{ item.properties['Cases'] | url_encode }}&artwork={{ item.properties['Artwork Option'] | url_encode }}
                  {%- endcapture -%}
                  <a href="{{ item.url }}{% if item.url contains '?' %}&{% else %}?{% endif %}{{ edit_query | strip }}" class="tf-cart-link-btn">Edit Spec</a>
                  <button
                    type="button"
                    class="tf-cart-link-btn"
                    onclick="TapeFoxCart.changeQty('{{ item.key }}', 0)"
                  >Remove</button>
                </div>
              </div>

              <!-- Bottom Row: Notice or Attached Artwork File -->
              <div class="tf-cart-bottom-row" data-line-key="{{ item.key }}">
                {% if item.properties['Artwork File Name'] != blank or item.properties['Artwork Option'] == 'Upload now' and item.properties['Artwork File Name'] != blank %}
                  <div class="tf-cart-file-pill">
                    <span class="tf-file-icon">Ai</span>
                    <div class="tf-file-details">
                      <span class="tf-file-name">{{ item.properties['Artwork File Name'] }}</span>
                      <span class="tf-file-size">{{ item.properties['Artwork File Size'] | default: 'Uploaded File' }}</span>
                    </div>
                    <button type="button" class="tf-file-remove" onclick="TapeFoxCart.removeAttachedFile(this, '{{ item.key }}')" aria-label="Remove attachment">×</button>
                  </div>
                {% else %}
                  <div class="tf-cart-notice-text">
                    We email you an upload link the moment you pay. The order is already placed nothing is waiting on this.
                  </div>
                  <button type="button" class="tf-cart-attach-btn" onclick="TapeFoxCart.triggerUpload(this, '{{ item.key }}')">Attach now</button>
                {% endif %}
              </div>

            </div>
          {% endfor %}
        </div>

        <!-- RIGHT: Order Summary Sidebar -->
        <aside class="tf-cart-summary-sidebar">
          <div class="tf-summary-card">
            <h2 class="tf-summary-title">{{ section.settings.summary_heading | default: 'Order summary' }}</h2>

            <!-- Subtotal Breakdown Rows -->
            <div class="tf-summary-rows">
              <div class="tf-summary-row">
                <span class="tf-summary-label">Tape</span>
                <span class="tf-summary-value" id="tfSummarySubtotal">
                  {% if cart.total_price > 0 %}
                    {{ cart.total_price | money }}
                  {% else %}
                    $464.63
                  {% endif %}
                </span>
              </div>

              <div class="tf-summary-row">
                <span class="tf-summary-label">Shipping</span>
                <span class="tf-summary-value tf-summary-value--green">Free</span>
              </div>

              <div class="tf-summary-row">
                <span class="tf-summary-label">Sales tax</span>
                <span class="tf-summary-value tf-summary-value--muted">Calculated at checkout</span>
              </div>
            </div>

            <!-- Order note -->
            <div class="tf-summary-note-wrap">
              <textarea
                name="note"
                id="CartSpecialInstructions"
                class="tf-summary-note"
                placeholder="Order note"
              >{{ cart.note }}</textarea>
            </div>

            <!-- Checkout CTA -->
            <form action="/pages/checkout" method="get" id="tfCheckoutForm">
              <button type="submit" name="checkout" class="tf-summary-checkout-btn">
                Checkout
              </button>
            </form>

            <!-- Footer guarantee / note -->
            <p class="tf-summary-footer-text">
              {{ section.settings.guarantee_text | default: 'Free shipping across the continental US' }}
            </p>
          </div>
        </aside>

      </div>
    {% else %}
      <!-- EMPTY CART STATE (When no items in cart) -->
      <div class="tf-cart-empty">
        <h2 class="tf-cart-empty-title">Your cart is currently empty</h2>
        <p class="tf-cart-empty-desc">You have no items in your shopping cart. Customize your tape and get started!</p>
        <a href="/collections" class="tf-cart-empty-btn">
          Explore all tapes →
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  window.TapeFoxCart = {
    changeQty: function(key, newQty) {
      if (newQty < 0) newQty = 0;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: newQty })
      })
      .then(res => res.json())
      .then(data => {
        if (window.updateHeaderCartCount) {
          window.updateHeaderCartCount(data.item_count);
        }
        window.location.reload();
      })
      .catch(err => {
        console.error('Cart update error:', err);
        window.location.reload();
      });
    },

    mockStepper: function(mockId, delta) {
      var valEl = document.getElementById(mockId + '-val');
      if (!valEl) return;
      var cur = parseInt(valEl.textContent.trim(), 10) || 1;
      cur += delta;
      if (cur < 1) cur = 1;
      valEl.textContent = cur;
    },

    mockRemove: function(mockId) {
      var card = document.querySelector('[data-mock-id="' + mockId + '"]');
      if (card) {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        card.style.transition = 'all 0.25s ease';
        setTimeout(function() {
          card.remove();
        }, 260);
      }
    },

    removeAttachedFile: function(btn, lineKey) {
      var pill = btn.closest('.tf-cart-file-pill');
      if (pill) {
        var parentRow = pill.closest('.tf-cart-bottom-row');
        pill.remove();
        if (parentRow) {
          parentRow.innerHTML = '<div class="tf-cart-notice-text">We email you an upload link the moment you pay. The order is already placed nothing is waiting on this.</div><button type="button" class="tf-cart-attach-btn" onclick="TapeFoxCart.triggerUpload(this, \'' + (lineKey || '') + '\')">Attach now</button>';
        }
      }
    },

    triggerUpload: function(btn, lineKey) {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = '.pdf,.ai,.eps,.png,.jpg,.jpeg';
      input.onchange = function(e) {
        var file = e.target.files[0];
        if (!file) return;
        var parentRow = btn.closest('.tf-cart-bottom-row');
        if (parentRow) {
          var sizeMb = (file.size / (1024 * 1024)).toFixed(1);
          parentRow.innerHTML = '<div class="tf-cart-file-pill">' +
            '<span class="tf-file-icon">Ai</span>' +
            '<div class="tf-file-details">' +
              '<span class="tf-file-name">' + file.name + '</span>' +
              '<span class="tf-file-size">' + sizeMb + ' MB of 30 MB</span>' +
            '</div>' +
            '<button type="button" class="tf-file-remove" onclick="TapeFoxCart.removeAttachedFile(this, \'' + (lineKey || '') + '\')" aria-label="Remove attachment">×</button>' +
          '</div>';
        }
      };
      input.click();
    }
  };
</script>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Cart Page Heading",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Card Eyebrow",
      "default": "Custom printed"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary Heading",
      "default": "Order summary"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "Free shipping across the continental US"
    }
  ]
}
{% endschema %}
