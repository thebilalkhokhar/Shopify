{{ 'contact-faqs.css' | asset_url | stylesheet_tag }}

<section
  id="contact-faqs-{{ section.id }}"
  class="contact-faqs-section"
  style="
    --cfaqs-bg: {{ section.settings.card_bg | default: '#FAF7F0' }};
    --cfaqs-border: {{ section.settings.card_border | default: '#171008' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="cfaqs-outer-wrap">
    <div class="cfaqs-card">

      <!-- Top Row of Circular Tape / Perforation Dots -->
      <div class="cfaqs-tape-perforations" aria-hidden="true">
        {% for i in (1..26) %}
          <span class="cfaqs-perf-dot"></span>
        {% endfor %}
      </div>

      <div class="cfaqs-grid">

        <!-- Left Column: Badge, Heading with Sparkles, Desc, Buttons, Mascot with Boxes -->
        <div class="cfaqs-left-col">
          
          <div class="cfaqs-header-info">
            {% if section.settings.badge_text != blank %}
              <div class="cfaqs-badge-wrap">
                <span class="cfaqs-badge">{{ section.settings.badge_text }}</span>
              </div>
            {% endif %}

            <div class="cfaqs-title-row">
              {% if section.settings.heading != blank %}
                <h2 class="cfaqs-title">{{ section.settings.heading }}</h2>
              {% endif %}

              <!-- Orange Sparkle Stars -->
              <span class="cfaqs-sparkles" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="#E85D18">
                  <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5L12 0z"/>
                </svg>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="#E85D18">
                  <path d="M12 0l2.5 9.5L24 12l-9.5 2.5L12 24l-2.5-9.5L0 12l9.5-2.5L12 0z"/>
                </svg>
              </span>
            </div>

            {% if section.settings.description != blank %}
              <p class="cfaqs-desc">{{ section.settings.description }}</p>
            {% endif %}
          </div>

          <!-- Bottom Area: Buttons (Bottom-Left) + Mascot On Boxes (Bottom-Right of Left Col) -->
          <div class="cfaqs-bottom-area">
            
            <div class="cfaqs-actions">
              {% if section.settings.btn1_text != blank %}
                <a href="{{ section.settings.btn1_url | default: '#contact' }}" class="cfaqs-btn cfaqs-btn--outline">
                  {{ section.settings.btn1_text }}
                </a>
              {% endif %}

              {% if section.settings.btn2_text != blank %}
                <a href="{{ section.settings.btn2_url | default: '#contact' }}" class="cfaqs-btn cfaqs-btn--primary">
                  {{ section.settings.btn2_text }}
                </a>
              {% endif %}
            </div>

            <!-- Fox Mascot sitting on Tape Boxes -->
            <div class="cfaqs-mascot-box">
              {% if section.settings.mascot_image != blank %}
                <img
                  src="{{ section.settings.mascot_image | image_url: width: 600 }}"
                  alt="{{ section.settings.mascot_image.alt | default: 'TapeFox Mascot on Boxes' }}"
                  class="cfaqs-mascot-img"
                  width="{{ section.settings.mascot_width | default: 280 }}"
                  height="auto"
                  loading="lazy"
                >
              {% else %}
                <img
                  src="shopify://shop_images/faqsMoscout.png"
                  alt="TapeFox Mascot on Boxes"
                  class="cfaqs-mascot-img"
                  width="280"
                  height="auto"
                  loading="lazy"
                  onerror="this.style.display='none'"
                >
              {% endif %}
            </div>

          </div>

        </div>

        <!-- Right Column: Pill Accordion Items -->
        <div class="cfaqs-right-col">
          <div class="cfaqs-accordion">
            {% for block in section.blocks %}
              {% assign is_first = forloop.first %}
              <div
                class="cfaqs-item {% if is_first %}is-open{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="cfaqs-question-btn"
                  aria-expanded="{% if is_first %}true{% else %}false{% endif %}"
                >
                  <span class="cfaqs-question-text">{{ block.settings.question }}</span>
                  <span class="cfaqs-toggle-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#171008" stroke-width="2.5" stroke-linecap="round">
                      <line class="cfaqs-icon-v" x1="12" y1="5" x2="12" y2="19"></line>
                      <line class="cfaqs-icon-h" x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </span>
                </button>

                <div class="cfaqs-answer-wrap">
                  <div class="cfaqs-answer-content">
                    <p>{{ block.settings.answer }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    function initCfaqs() {
      const section = document.getElementById('contact-faqs-{{ section.id }}');
      if (!section) return;

      const items = section.querySelectorAll('.cfaqs-item');
      items.forEach(function(item) {
        const btn = item.querySelector('.cfaqs-question-btn');
        if (!btn) return;

        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const isOpen = item.classList.contains('is-open');

          // Close other items
          items.forEach(function(otherItem) {
            if (otherItem !== item && otherItem.classList.contains('is-open')) {
              otherItem.classList.remove('is-open');
              otherItem.querySelector('.cfaqs-question-btn')?.setAttribute('aria-expanded', 'false');
            }
          });

          // Toggle current
          if (isOpen) {
            item.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            item.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCfaqs);
    } else {
      initCfaqs();
    }
  })();
</script>

{% schema %}
{
  "name": "Contact FAQs Section",
  "settings": [
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FAF7F0"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Border Color",
      "default": "#171008"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you order"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Custom tape can come with a few questions. We've answered the big ones here: design help, fees, shipping, samples, and how the whole thing works without the corporate word salad."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "STILL GOT QUESTIONS?"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Support"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 Link"
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot Image"
    },
    {
      "type": "range",
      "id": "mascot_width",
      "label": "Mascot Width (px)",
      "min": 180,
      "max": 400,
      "step": 10,
      "default": 280
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can you help with my tape design?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes. Design support is free. Send us what you have even if it's just a logo and a vague idea and we'll help make it look good."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQs Section",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Can you help with my tape design?",
            "answer": "Yes. Design support is free. Send us what you have even if it's just a logo and a vague idea and we'll help make it look good."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are there any plate or setup fees?",
            "answer": "No hidden fees. What you see on the product page is what you pay."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long will my custom tape take?",
            "answer": "Standard turnaround is 12-14 business days from artwork approval."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What do I need to get started?",
            "answer": "Just your logo file (vector PDF, AI, or high-res PNG) and your preferred tape specifications."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I change my design later?",
            "answer": "Yes, you can update your design anytime before the proof is approved for printing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
