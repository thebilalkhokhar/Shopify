{{ 'blog-banner.css' | asset_url | stylesheet_tag }}

{%- assign current_blog = section.settings.blog | default: blog -%}
{%- if current_blog == blank or current_blog.articles.size == 0 -%}
  {%- assign current_blog = blogs['news'] -%}
{%- endif -%}

{%- assign feat_article = section.settings.featured_article -%}
{%- if feat_article == blank and current_blog.articles.size > 0 -%}
  {%- assign feat_article = current_blog.articles.first -%}
{%- endif -%}

<section
  id="blog-banner-{{ section.id }}"
  class="blog-banner-section"
  style="
    --bb-card-bg: {{ section.settings.card_bg | default: '#EA5B1B' }};
    --bb-card-border: {{ section.settings.card_border | default: '#EA5B1B' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="blog-banner-container">
    
    <!-- Top Header Area: Fox Reading + Header Title & Subtitle with Badge & Sparkles -->
    <div class="blog-banner-header">
      <!-- Fox Mascot Reading Book/Notes -->
      <div class="bb-fox-mascot">
        {% if section.settings.fox_image != blank %}
          <img
            src="{{ section.settings.fox_image | image_url: width: 400 }}"
            alt="{{ section.settings.fox_image.alt | default: 'TapeFox Reading Mascot' }}"
            class="bb-fox-img"
            width="{{ section.settings.fox_width | default: 180 }}"
            height="auto"
            loading="eager"
          >
        {% elsif request.design_mode %}
          <div class="bb-fox-placeholder">🦊 Mascot</div>
        {% endif %}
      </div>

      <!-- Header Content: Badge, Sparkles, Title, Subheading -->
      <div class="bb-header-content">
        <div class="bb-badge-row">
          {% if section.settings.badge_text != blank %}
            <span class="bb-badge">{{ section.settings.badge_text }}</span>
          {% endif %}
          
          <!-- Sparkles Icon Decoration -->
          <span class="bb-sparkles" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#EA5B1B">
              <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5L12 0Z"/>
            </svg>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="#EA5B1B" class="bb-sparkle-sm">
              <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5L12 0Z"/>
            </svg>
          </span>
        </div>

        {% if section.settings.heading != blank %}
          <h1 class="bb-main-title">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="bb-main-desc">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    </div>

    <!-- Featured Blog Post Card with Tape Strips Decoration -->
    <div class="bb-card-wrapper">
      
      <!-- Top Left Tape Strip -->
      <div class="bb-tape bb-tape-top-left" aria-hidden="true"></div>
      
      <!-- Bottom Right Tape Strip -->
      <div class="bb-tape bb-tape-bottom-right" aria-hidden="true"></div>

      <!-- Main Orange Featured Card -->
      <div class="bb-featured-card">
        
        <!-- Left Column: Date, Title, Excerpt, CTA Button -->
        <div class="bb-card-content">
          <!-- Post Date -->
          <div class="bb-post-date">
            {% if feat_article != blank %}
              {{ feat_article.published_at | date: "%B %d, %Y" }}
            {% else %}
              {{ section.settings.featured_date | default: 'August 14, 2026' }}
            {% endif %}
          </div>

          <!-- Post Title -->
          <h2 class="bb-post-title">
            {% if feat_article != blank %}
              <a href="{{ feat_article.url }}">{{ feat_article.title }}</a>
            {% else %}
              <a href="{{ section.settings.featured_link | default: '/blogs/news/how-to-make-packaging-look-less-meh' }}">
                {{ section.settings.featured_title | default: 'How to Make Packaging Look Less Meh' }}
              </a>
            {% endif %}
          </h2>

          <!-- Post Excerpt -->
          <div class="bb-post-excerpt">
            {% if feat_article != blank %}
              {% if feat_article.excerpt != blank %}
                {{ feat_article.excerpt }}
              {% else %}
                <p>{{ feat_article.content | strip_html | truncatewords: 35 }}</p>
              {% endif %}
            {% else %}
              {{ section.settings.featured_excerpt }}
            {% endif %}
          </div>

          <!-- CTA Button -->
          <a
            href="{% if feat_article != blank %}{{ feat_article.url }}{% else %}{{ section.settings.featured_link | default: '/blogs/news/how-to-make-packaging-look-less-meh' }}{% endif %}"
            class="bb-post-btn"
          >
            <span>{{ section.settings.button_text | default: 'Read it' }}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Right Column: Featured Image with Category Tag Badge -->
        <div class="bb-card-media">
          <a href="{% if feat_article != blank %}{{ feat_article.url }}{% else %}{{ section.settings.featured_link | default: '/blogs/news/how-to-make-packaging-look-less-meh' }}{% endif %}" class="bb-media-link" style="display: block; text-decoration: none;">
            <div class="bb-media-inner">
              <!-- Category Tag -->
              {% assign badge_tag = section.settings.category_tag %}
              {% if feat_article != blank and feat_article.tags.size > 0 %}
                {% assign badge_tag = feat_article.tags | first %}
              {% endif %}

              {% if badge_tag != blank %}
                <span class="bb-category-badge">{{ badge_tag }}</span>
              {% endif %}

              <!-- Article Image -->
              {% if feat_article != blank and feat_article.image != blank %}
                <img
                  src="{{ feat_article.image | image_url: width: 1200 }}"
                  alt="{{ feat_article.image.alt | default: feat_article.title }}"
                  class="bb-featured-img"
                  width="600"
                  height="auto"
                  loading="eager"
                >
              {% elsif section.settings.featured_image != blank %}
                <img
                  src="{{ section.settings.featured_image | image_url: width: 1200 }}"
                  alt="{{ section.settings.featured_image.alt | default: section.settings.featured_title }}"
                  class="bb-featured-img"
                  width="600"
                  height="auto"
                  loading="eager"
                >
              {% elsif request.design_mode %}
                <div class="bb-media-placeholder">
                  <span>🖼️ Upload Featured Article Image</span>
                </div>
              {% endif %}
            </div>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    var banner = document.getElementById('blog-banner-{{ section.id }}');
    if (!banner) return;
    var featCard = banner.querySelector('.bb-featured-card');
    if (featCard) {
      featCard.addEventListener('click', function(e) {
        var titleEl = featCard.querySelector('.bb-post-title a');
        var descEl = featCard.querySelector('.bb-post-excerpt');
        var dateEl = featCard.querySelector('.bb-post-date');
        var badgeEl = featCard.querySelector('.bb-category-badge');
        var imgEl = featCard.querySelector('.bb-featured-img');

        var postLink = featCard.querySelector('.bb-post-title a') || featCard.querySelector('a');
        var postData = {
          title: titleEl ? titleEl.textContent.trim() : 'How to Make Packaging Look Less Meh',
          description: descEl ? descEl.innerHTML.trim() : '',
          date: dateEl ? dateEl.textContent.trim() : 'August 14, 2026',
          category: badgeEl ? badgeEl.textContent.trim() : 'Branding',
          image: imgEl ? imgEl.getAttribute('src') : '',
          url: postLink ? postLink.getAttribute('href') : ''
        };

        try {
          sessionStorage.setItem('tf_active_blog', JSON.stringify(postData));
        } catch (err) {}
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Blog Banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Header"
    },
    {
      "type": "image_picker",
      "id": "fox_image",
      "label": "Fox Mascot Image (Reading)"
    },
    {
      "type": "range",
      "id": "fox_width",
      "label": "Fox Mascot Width",
      "min": 100,
      "max": 300,
      "step": 10,
      "default": 170,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Blogs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Sticky Business."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Description",
      "default": "Packaging tips, branding ideas, tape talk, and other things we probably care about more than we should. No SEO filler if a post is not useful we do not publish it."
    },
    {
      "type": "header",
      "content": "Featured Article (Dynamic or Manual)"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog",
      "info": "Choose blog from Shopify Admin (defaults to News). The latest post automatically displays as the featured banner!"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Manual Featured Article Override",
      "info": "Optionally pin a specific article. If left blank, the newest article from the selected blog is shown automatically."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#EA5B1B"
    },
    {
      "type": "text",
      "id": "featured_date",
      "label": "Manual Date (Fallback)",
      "default": "August 14, 2026"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Manual Title (Fallback)",
      "default": "How to Make Packaging Look Less Meh"
    },
    {
      "type": "richtext",
      "id": "featured_excerpt",
      "label": "Manual Excerpt (Fallback)",
      "default": "<p>Your packaging has one job before anything else: make people want to look twice. It does not need to be loud, expensive, or covered in glitter. It just needs to feel intentional.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Read it"
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "Manual Article Link"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Manual Article Image"
    },
    {
      "type": "text",
      "id": "category_tag",
      "label": "Manual Category Tag Badge",
      "default": "Branding"
    }
  ],
  "presets": [
    {
      "name": "Blog Banner"
    }
  ]
}
{% endschema %}
