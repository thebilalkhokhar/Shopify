{{ 'auth-login.css' | asset_url | stylesheet_tag }}

<div class="tf-account-wrapper">
  <!-- Top Bar / Breadcrumb -->
  <div class="tf-account-container">
    <div class="tf-account-header-bar">
      <div>
        <div class="tf-account-badge">Your Account</div>
        <h1 class="tf-account-heading">
          Hello, {{ customer.first_name | default: 'there' }}
        </h1>
        <p class="tf-account-email">{{ customer.email }}</p>
      </div>
      <div class="tf-account-actions">
        <a href="{{ routes.account_logout_url }}" class="tf-btn-secondary tf-btn-logout">
          Sign out
        </a>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="tf-account-grid">
      <!-- Left Column: Orders History -->
      <div class="tf-account-card tf-orders-card">
        <div class="tf-card-header">
          <h2 class="tf-card-title">Order History</h2>
          <span class="tf-card-count">{{ customer.orders.size }} {{ customer.orders.size | pluralize: 'order', 'orders' }}</span>
        </div>

        {%- paginate customer.orders by 10 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="tf-orders-table-wrap">
              <table class="tf-orders-table">
                <thead>
                  <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th>Payment</th>
                    <th>Fulfillment</th>
                    <th style="text-align: right;">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td data-label="Order">
                        <a href="{{ order.customer_url }}" class="tf-order-link">
                          {{ order.name }}
                        </a>
                      </td>
                      <td data-label="Date">
                        {{ order.created_at | time_tag: format: 'date' }}
                      </td>
                      <td data-label="Payment">
                        <span class="tf-status-pill tf-status-{{ order.financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                      </td>
                      <td data-label="Fulfillment">
                        <span class="tf-status-pill tf-status-{{ order.fulfillment_status }}">
                          {{ order.fulfillment_status_label }}
                        </span>
                      </td>
                      <td data-label="Total" style="text-align: right; font-weight: 600;">
                        {{ order.total_net_amount | default: order.total_price | money_with_currency }}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="tf-pagination">
                {{ paginate | default_pagination }}
              </div>
            {%- endif -%}

          {%- else -%}
            <div class="tf-empty-orders">
              <div class="tf-empty-icon">📦</div>
              <h3 class="tf-empty-title">No orders placed yet</h3>
              <p class="tf-empty-desc">When you order custom tapes, proofing milestones and shipping tracking will appear here.</p>
              <a href="{{ routes.all_products_collection_url | default: '/collections' }}" class="tf-btn-primary">
                Explore Products
              </a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <!-- Right Column: Account Details & Default Address -->
      <div class="tf-account-card tf-details-card">
        <div class="tf-card-header">
          <h2 class="tf-card-title">Account Details</h2>
        </div>

        <div class="tf-address-box">
          <div class="tf-address-title-row">
            <span class="tf-address-tag">Default Address</span>
            <a href="{{ routes.account_addresses_url }}" class="tf-address-edit-link">
              View Addresses ({{ customer.addresses_count }})
            </a>
          </div>

          {%- if customer.default_address -%}
            <div class="tf-address-details">
              <p class="tf-addr-name"><strong>{{ customer.default_address.name }}</strong></p>
              {%- if customer.default_address.company != blank -%}
                <p>{{ customer.default_address.company }}</p>
              {%- endif -%}
              <p>{{ customer.default_address.address1 }}</p>
              {%- if customer.default_address.address2 != blank -%}
                <p>{{ customer.default_address.address2 }}</p>
              {%- endif -%}
              <p>
                {{ customer.default_address.city }}, 
                {{ customer.default_address.province_code }} {{ customer.default_address.zip }}
              </p>
              <p>{{ customer.default_address.country }}</p>
              {%- if customer.default_address.phone != blank -%}
                <p class="tf-addr-phone">📞 {{ customer.default_address.phone }}</p>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="tf-empty-addr-text">No primary address saved yet.</p>
            <a href="{{ routes.account_addresses_url }}" class="tf-btn-secondary" style="display:inline-block;margin-top:10px;">
              Add Address
            </a>
          {%- endif -%}
        </div>

        <!-- Support Box -->
        <div class="tf-account-support-box">
          <h3 class="tf-support-title">Need help with an order?</h3>
          <p class="tf-support-desc">Have questions regarding plate proofs, ink matches, or reorders? Our Texas production team is ready.</p>
          <div class="tf-support-links">
            <a href="mailto:hello@tapefox.com" class="tf-support-link">✉ hello@tapefox.com</a>
            <a href="tel:+18005550199" class="tf-support-link">📞 (800) 555-0199</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.tf-account-wrapper {
  background-color: #FAF6F0;
  min-height: 80vh;
  padding: 60px 20px 80px 20px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #191410;
}
.tf-account-container {
  max-width: 1140px;
  margin: 0 auto;
}
.tf-account-header-bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
  flex-wrap: wrap;
  padding-bottom: 24px;
  border-bottom: 1.5px solid #E6DFC5;
}
.tf-account-badge {
  display: inline-block;
  background-color: #FEC33F;
  color: #191410;
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1.5px solid #191410;
  margin-bottom: 8px;
}
.tf-account-heading {
  font-family: var(--custom-font-family, "Bringbold Nineties", Georgia, serif);
  font-size: 38px;
  line-height: 1.1;
  color: #191410;
  margin: 0 0 6px 0;
}
.tf-account-email {
  color: #726A61;
  font-size: 14px;
  margin: 0;
}
.tf-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #191410;
  border: 1.8px solid #191410;
  padding: 10px 20px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 13.5px;
  text-decoration: none;
  box-shadow: 0 2px 0 #191410;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  cursor: pointer;
}
.tf-btn-secondary:hover {
  transform: translateY(-1px);
  box-shadow: 0 3px 0 #191410;
}
.tf-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #F55A00;
  color: #ffffff;
  border: 1.8px solid #191410;
  padding: 12px 28px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  box-shadow: 0 3px 0 #191410;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  margin-top: 16px;
}
.tf-btn-primary:hover {
  background: #E04E00;
  transform: translateY(-1px);
  box-shadow: 0 4px 0 #191410;
}
.tf-account-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 28px;
  align-items: start;
}
.tf-account-card {
  background: #ffffff;
  border: 2px solid #191410;
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 4px 0 #191410;
}
.tf-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1.5px solid #F0ECE1;
}
.tf-card-title {
  font-family: var(--custom-font-family, "Bringbold Nineties", Georgia, serif);
  font-size: 24px;
  color: #191410;
  margin: 0;
}
.tf-card-count {
  font-size: 12.5px;
  font-weight: 600;
  color: #726A61;
}
.tf-orders-table-wrap {
  overflow-x: auto;
}
.tf-orders-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 14px;
}
.tf-orders-table th {
  padding: 12px 14px;
  font-size: 12px;
  text-transform: uppercase;
  color: #726A61;
  font-weight: 600;
  border-bottom: 1.5px solid #191410;
  letter-spacing: 0.5px;
}
.tf-orders-table td {
  padding: 16px 14px;
  border-bottom: 1px solid #F0ECE1;
  color: #191410;
  vertical-align: middle;
}
.tf-order-link {
  color: #F55A00;
  font-weight: 700;
  text-decoration: underline;
}
.tf-order-link:hover {
  color: #191410;
}
.tf-status-pill {
  display: inline-block;
  font-size: 11.5px;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 999px;
  text-transform: capitalize;
}
.tf-status-paid, .tf-status-fulfilled {
  background: #E8F7ED;
  color: #1E7E34;
}
.tf-status-unfulfilled, .tf-status-pending {
  background: #FFF4E5;
  color: #B25E00;
}
.tf-empty-orders {
  text-align: center;
  padding: 40px 20px;
}
.tf-empty-icon {
  font-size: 42px;
  margin-bottom: 12px;
}
.tf-empty-title {
  font-size: 18px;
  font-weight: 700;
  color: #191410;
  margin: 0 0 8px 0;
}
.tf-empty-desc {
  color: #726A61;
  font-size: 14px;
  max-width: 360px;
  margin: 0 auto;
  line-height: 1.5;
}
.tf-address-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.tf-address-tag {
  font-size: 11.5px;
  font-weight: 700;
  text-transform: uppercase;
  background: #FAF6F0;
  border: 1px solid #D9D2C7;
  padding: 3px 8px;
  border-radius: 6px;
  color: #574F46;
}
.tf-address-edit-link {
  font-size: 12.5px;
  color: #F55A00;
  font-weight: 600;
  text-decoration: underline;
}
.tf-address-details p {
  margin: 0 0 4px 0;
  font-size: 14px;
  color: #574F46;
  line-height: 1.4;
}
.tf-addr-phone {
  margin-top: 8px !important;
  font-size: 13px !important;
  color: #726A61 !important;
}
.tf-account-support-box {
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1.5px solid #F0ECE1;
}
.tf-support-title {
  font-size: 15px;
  font-weight: 700;
  color: #191410;
  margin: 0 0 6px 0;
}
.tf-support-desc {
  font-size: 13px;
  color: #726A61;
  line-height: 1.45;
  margin: 0 0 12px 0;
}
.tf-support-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.tf-support-link {
  font-size: 13px;
  font-weight: 600;
  color: #191410;
  text-decoration: none;
}
.tf-support-link:hover {
  color: #F55A00;
  text-decoration: underline;
}
@media (max-width: 860px) {
  .tf-account-grid {
    grid-template-columns: 1fr;
  }
  .tf-account-heading {
    font-size: 30px;
  }
}
</style>

{% schema %}
{
  "name": "Customer Account",
  "tag": "section",
  "class": "section-customer-account",
  "settings": []
}
{% endschema %}
