{{ 'order-sample-banner.css' | asset_url | stylesheet_tag }}

<section
  id="order-sample-banner-{{ section.id }}"
  class="order-sample-section"
  style="--osb-banner-bg: {{ section.settings.card_bg | default: '#FAA72B' }};"
  {{ section.shopify_attributes }}
>
  <div class="osb-container">
    <div class="osb-layout">

      <!-- =======================================================================
           LEFT COLUMN: Sample Image Banner & Below Description
           ======================================================================= -->
      <div class="osb-left-col">
        <!-- Golden Banner Card -->
        <div class="osb-banner-card">
          <!-- Top Left Pill Badge -->
          <div class="osb-badge-pill">
            {{ section.settings.badge_text | default: 'Order Sample' }}
          </div>

          <!-- Main Image -->
          <div class="osb-main-image-wrap">
            {% if section.settings.sample_image != blank %}
              {{ section.settings.sample_image | image_url: width: 1200 | image_tag: class: 'osb-main-image', alt: section.settings.badge_text, loading: 'eager' }}
            {% else %}
              <div class="osb-dummy-box">
                <svg width="84" height="84" viewBox="0 0 24 24" fill="none" stroke="#171008" stroke-width="1.2">
                  <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                  <path d="m3.3 7 8.7 5 8.7-5"/>
                  <path d="M12 22V12"/>
                </svg>
                <span style="font-weight: 700; font-size: 14px;">Upload Sample Box Image in Theme Editor</span>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Description Section Below Banner -->
        <div class="osb-desc-section">
          <h2 class="osb-desc-title">{{ section.settings.desc_heading | default: 'Description' }}</h2>
          <div class="osb-desc-subtitle">{{ section.settings.desc_subtitle | default: 'Custom Polypropylene Tape' }}</div>
          <p class="osb-desc-paragraph">
            {{ section.settings.desc_text | default: 'Custom printed paper tape is an ideal tool for any e-commerce seller, shipping house, or retail brand looking to make their products stand out in transit. Custom printed Kraft paper tape is eco-friendly, strong, and water-activated, creating a secure seal to protect your goods during shipping while promoting your brand.' }}
          </p>

          <!-- 4-Point Sparkle Bullet Points -->
          <ul class="osb-sparkle-list">
            {%- assign dp1 = section.settings.desc_point_1 | default: 'High-grade Kraft paper for ultimate strength and security' -%}
            {%- assign dp2 = section.settings.desc_point_2 | default: 'Water-activated adhesive forms a tamper-evident seal' -%}
            {%- assign dp3 = section.settings.desc_point_3 | default: 'Available in non-reinforced or reinforced paper options' -%}
            {%- assign dp4 = section.settings.desc_point_4 | default: 'Print up to three colors to showcase your brand' -%}
            {%- assign dp5 = section.settings.desc_point_5 | default: 'Eco-friendly and recyclable' -%}

            {% if dp1 != blank %}
              <li class="osb-sparkle-item">
                <span class="osb-sparkle-icon" aria-hidden="true">✦</span>
                <span>{{ dp1 }}</span>
              </li>
            {% endif %}
            {% if dp2 != blank %}
              <li class="osb-sparkle-item">
                <span class="osb-sparkle-icon" aria-hidden="true">✦</span>
                <span>{{ dp2 }}</span>
              </li>
            {% endif %}
            {% if dp3 != blank %}
              <li class="osb-sparkle-item">
                <span class="osb-sparkle-icon" aria-hidden="true">✦</span>
                <span>{{ dp3 }}</span>
              </li>
            {% endif %}
            {% if dp4 != blank %}
              <li class="osb-sparkle-item">
                <span class="osb-sparkle-icon" aria-hidden="true">✦</span>
                <span>{{ dp4 }}</span>
              </li>
            {% endif %}
            {% if dp5 != blank %}
              <li class="osb-sparkle-item">
                <span class="osb-sparkle-icon" aria-hidden="true">✦</span>
                <span>{{ dp5 }}</span>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- =======================================================================
           RIGHT COLUMN: Config Card ("Hold it first.")
           ======================================================================= -->
      <div class="osb-right-col">
        <div class="osb-config-card">

          <!-- Heading -->
          <h1 class="osb-headline">{{ section.settings.card_title | default: 'Hold it first.' }}</h1>

          <!-- Price Subtitle -->
          <div class="osb-sub-price">
            Starting at <strong>${{ section.settings.base_price | default: '99.00' }} a box</strong>
          </div>

          <!-- Lead Paragraph -->
          <p class="osb-lead-text">
            {{ section.settings.card_intro | default: 'A printed roll and a blank roll of every material, in a box, on us. Feel the difference between paper and poly before you order sixty-four cases of the wrong one.' }}
          </p>

          <!-- "What is in the box?" -->
          <div class="osb-box-title">{{ section.settings.box_contents_title | default: 'What is in the box?' }}</div>

          <ul class="osb-feature-list">
            {%- assign f1 = section.settings.feature_1 | default: 'One short roll of every material poly, paper, PVC, freezer and flatback printed with our own mark, so you can judge ink on each surface.' -%}
            {%- assign f2 = section.settings.feature_2 | default: 'The same five materials unprinted. Feel the base before the ink goes on, and hear the difference coming off the roll.' -%}
            {%- assign f3 = section.settings.feature_3 | default: 'All nine inks laid down on white tape and on kraft tape. The same colour reads differently on each.' -%}
            {%- assign f4 = section.settings.feature_4 | default: 'Already sealed with water-activated paper tape. Try to open it that is what tamper-evident actually looks like.' -%}
            {%- assign f5 = section.settings.feature_5 | default: 'Case breaks at 5, 10, 25, 50 and 64, plus the plate charge, so you can work your number out at your desk.' -%}

            {% if f1 != blank %}
              <li class="osb-feature-item">
                <span class="osb-check-badge" aria-hidden="true">
                  {% if section.settings.custom_check_icon != blank %}
                    {{ section.settings.custom_check_icon | image_url: width: 64 | image_tag: class: 'osb-check-img', alt: 'Icon', width: 22, height: 22 }}
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                      <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                    </svg>
                  {% endif %}
                </span>
                <span>{{ f1 }}</span>
              </li>
            {% endif %}

            {% if f2 != blank %}
              <li class="osb-feature-item">
                <span class="osb-check-badge" aria-hidden="true">
                  {% if section.settings.custom_check_icon != blank %}
                    {{ section.settings.custom_check_icon | image_url: width: 64 | image_tag: class: 'osb-check-img', alt: 'Icon', width: 22, height: 22 }}
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                      <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                    </svg>
                  {% endif %}
                </span>
                <span>{{ f2 }}</span>
              </li>
            {% endif %}

            {% if f3 != blank %}
              <li class="osb-feature-item">
                <span class="osb-check-badge" aria-hidden="true">
                  {% if section.settings.custom_check_icon != blank %}
                    {{ section.settings.custom_check_icon | image_url: width: 64 | image_tag: class: 'osb-check-img', alt: 'Icon', width: 22, height: 22 }}
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                      <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                    </svg>
                  {% endif %}
                </span>
                <span>{{ f3 }}</span>
              </li>
            {% endif %}

            {% if f4 != blank %}
              <li class="osb-feature-item">
                <span class="osb-check-badge" aria-hidden="true">
                  {% if section.settings.custom_check_icon != blank %}
                    {{ section.settings.custom_check_icon | image_url: width: 64 | image_tag: class: 'osb-check-img', alt: 'Icon', width: 22, height: 22 }}
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                      <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                    </svg>
                  {% endif %}
                </span>
                <span>{{ f4 }}</span>
              </li>
            {% endif %}

            {% if f5 != blank %}
              <li class="osb-feature-item">
                <span class="osb-check-badge" aria-hidden="true">
                  {% if section.settings.custom_check_icon != blank %}
                    {{ section.settings.custom_check_icon | image_url: width: 64 | image_tag: class: 'osb-check-img', alt: 'Icon', width: 22, height: 22 }}
                  {% else %}
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                      <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                      <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                    </svg>
                  {% endif %}
                </span>
                <span>{{ f5 }}</span>
              </li>
            {% endif %}

            <!-- Dynamic Additional Blocks if added in theme editor -->
            {%- for block in section.blocks -%}
              {%- if block.type == 'box_feature' and block.settings.text != blank -%}
                <li class="osb-feature-item" {{ block.shopify_attributes }}>
                  <span class="osb-check-badge" aria-hidden="true">
                    {% if block.settings.custom_icon != blank %}
                      <img src="{{ block.settings.custom_icon | image_url: width: 64 }}" alt="Icon" width="22" height="22" class="osb-check-img">
                    {% elsif section.settings.custom_check_icon != blank %}
                      <img src="{{ section.settings.custom_check_icon | image_url: width: 64 }}" alt="Icon" width="22" height="22" class="osb-check-img">
                    {% else %}
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                        <path fill="#EA5B1B" d="M12 1.5l1.6 2 2.5-.5.9 2.4 2.5.7.1 2.6 2.1 1.5-.8 2.5 1.5 2.1-1.6 2 .5 2.5-2.4.9-.7 2.5-2.6.1-1.5 2.1-2.5-.8-2.1 1.5-2-1.6-2.5.5-.9-2.4-2.5-.7-.1-2.6-2.1-1.5.8-2.5-1.5-2.1 1.6-2-.5-2.5 2.4-.9.7-2.5 2.6-.1 1.5-2.1 2.5.8 2.1-1.5z"/>
                        <path stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M8.2 12.2l2.6 2.6 5.4-5.4"/>
                      </svg>
                    {% endif %}
                  </span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <hr class="osb-divider">

          <!-- Boxes Selector -->
          <span class="osb-field-label">BOXES</span>
          <div class="osb-boxes-selector-row">
            <!-- Stepper -->
            <div class="osb-stepper">
              <button type="button" class="osb-step-btn" id="osbQtyMinus" aria-label="Decrease quantity">−</button>
              <input type="text" id="osbQtyInput" class="osb-step-input" value="2" readonly>
              <button type="button" class="osb-step-btn" id="osbQtyPlus" aria-label="Increase quantity">+</button>
            </div>

            <!-- Preset Pills -->
            <div class="osb-pills-row">
              <button type="button" class="osb-num-pill is-active" data-val="2">2</button>
              <button type="button" class="osb-num-pill" data-val="3">3</button>
              <button type="button" class="osb-num-pill" data-val="4">4</button>
              <button type="button" class="osb-num-pill" data-val="5">5</button>
              <button type="button" class="osb-num-pill" data-val="10">10</button>
            </div>
          </div>

          <hr class="osb-divider">

          <!-- Total Price Row -->
          <div class="osb-total-row">
            <span class="osb-total-label">Total</span>
            <div class="osb-total-price-block">
              <div class="osb-total-price" id="osbTotalPrice">$464.63</div>
              <div class="osb-per-roll-price" id="osbPerRollPrice">$11.62 a roll</div>
            </div>
          </div>

          <!-- Black Summary Strip -->
          <div class="osb-summary-strip">
            <div class="osb-summary-col">
              <span class="osb-summary-label">Boxes</span>
              <span class="osb-summary-val" id="osbSummaryBoxes">2</span>
            </div>
            <div class="osb-summary-col">
              <span class="osb-summary-label">Printed roll</span>
              <span class="osb-summary-val">Yes</span>
            </div>
            <div class="osb-summary-col osb-summary-col--right">
              <span class="osb-summary-label">Shipping</span>
              <span class="osb-summary-val">1-2 Days</span>
            </div>
          </div>

          <!-- Add to Cart CTA Button -->
          <button type="button" class="osb-add-to-cart-btn" id="osbAddToCartBtn">
            Add to Cart
          </button>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    var qty = 2;
    var baseRate = 232.315; // 2 boxes = $464.63
    var rollsPerBox = 20;

    var inputEl = document.getElementById('osbQtyInput');
    var minusBtn = document.getElementById('osbQtyMinus');
    var plusBtn = document.getElementById('osbQtyPlus');
    var pills = document.querySelectorAll('.osb-num-pill');
    var totalPriceEl = document.getElementById('osbTotalPrice');
    var perRollPriceEl = document.getElementById('osbPerRollPrice');
    var summaryBoxesEl = document.getElementById('osbSummaryBoxes');
    var addBtn = document.getElementById('osbAddToCartBtn');

    function updatePrice(val) {
      qty = parseInt(val, 10);
      if (isNaN(qty) || qty < 1) qty = 1;

      if (inputEl) inputEl.value = qty;
      if (summaryBoxesEl) summaryBoxesEl.textContent = qty;

      // Update active state on preset pills
      pills.forEach(function(pill) {
        if (parseInt(pill.getAttribute('data-val'), 10) === qty) {
          pill.classList.add('is-active');
        } else {
          pill.classList.remove('is-active');
        }
      });

      // Price calculation matching reference exactly
      var total = (qty === 2) ? 464.63 : (qty * baseRate);
      var totalRolls = qty * rollsPerBox;
      var perRoll = (total / totalRolls).toFixed(2);

      if (totalPriceEl) totalPriceEl.textContent = '$' + total.toFixed(2);
      if (perRollPriceEl) perRollPriceEl.textContent = '$' + perRoll + ' a roll';
    }

    if (minusBtn) {
      minusBtn.addEventListener('click', function() {
        if (qty > 1) updatePrice(qty - 1);
      });
    }

    if (plusBtn) {
      plusBtn.addEventListener('click', function() {
        updatePrice(qty + 1);
      });
    }

    pills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var v = parseInt(this.getAttribute('data-val'), 10);
        updatePrice(v);
      });
    });

    // Add to cart click
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.classList.add('is-loading');
        addBtn.textContent = 'Adding...';

        var formData = {
          items: [{
            id: {{ all_products['sample-box'].variants.first.id | default: 0 }},
            quantity: qty,
            properties: {
              'Item': 'TapeFox Sample Box',
              'Boxes': qty,
              'Printed Roll': 'Yes',
              'Shipping': '1-2 Days'
            }
          }]
        };

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        })
        .then(function(res) {
          if (!res.ok) {
            // Fallback redirect if product id not in shopify db
            window.location.href = '/cart';
            return;
          }
          return res.json();
        })
        .then(function() {
          window.location.href = '/cart';
        })
        .catch(function() {
          window.location.href = '/cart';
        });
      });
    }
  })();
</script>

{% schema %}
{
