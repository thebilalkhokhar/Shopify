{{ 'auth-login.css' | asset_url | stylesheet_tag }}

<div class="tf-auth-page" id="TapeFoxResetRoot">
  <!-- Top Center Logo -->
  <header class="tf-auth-header">
    <a href="{{ routes.root_url }}" class="tf-auth-logo-link" aria-label="TapeFox Home">
      <img
        src="{{ 'headerLogo.svg' | file_url }}"
        alt="{{ shop.name }}"
        class="tf-auth-logo-img"
        width="135"
        height="32"
      >
    </a>
  </header>

  <!-- Toast -->
  <div id="tfToast" class="tf-toast" role="alert" aria-live="assertive"></div>

  <div class="tf-auth-main">
    <div class="tf-auth-sparkles" aria-hidden="true">
      <span class="tf-sparkle-star large">✦</span>
      <span class="tf-sparkle-star small">✦</span>
    </div>

    <div class="tf-auth-badge">Security</div>
    <h1 class="tf-auth-heading">Reset your<br><span class="tf-highlight-orange">password.</span></h1>
    <p class="tf-auth-subheading">Enter a new secure password for your TapeFox account.</p>

    {%- form 'reset_customer_password', id: 'tfResetForm' -%}
      {%- if form.errors -%}
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            var errEl = document.getElementById('tfResetErrors');
            if (errEl) errEl.style.display = 'block';
          });
        </script>
      {%- endif -%}

      <div class="tf-form-fields">
        {%- if form.errors -%}
          <div id="tfResetErrors" class="tf-field-error" style="display:block;margin-bottom:12px;text-align:left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <!-- New Password -->
        <div class="tf-field-wrap" id="tfResetPwWrap">
          <div class="tf-pw-input-wrap">
            <input
              type="password"
              name="customer[password]"
              id="tfResetPw"
              class="tf-auth-input"
              placeholder="New password (min 6 characters)"
              autocomplete="new-password"
              required
            >
            <button type="button" class="tf-pw-toggle" id="tfToggleResetPw" aria-label="Show password">
              <svg id="tfEyeShow1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="tfEyeHide1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <span class="tf-field-error">Password must be at least 6 characters.</span>
        </div>

        <!-- Confirm Password -->
        <div class="tf-field-wrap" id="tfResetPwCfmWrap">
          <div class="tf-pw-input-wrap">
            <input
              type="password"
              name="customer[password_confirmation]"
              id="tfResetPwCfm"
              class="tf-auth-input"
              placeholder="Confirm new password"
              autocomplete="new-password"
              required
            >
            <button type="button" class="tf-pw-toggle" id="tfToggleResetPwCfm" aria-label="Show password">
              <svg id="tfEyeShow2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="tfEyeHide2" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
          <span class="tf-field-error">Passwords do not match.</span>
        </div>
      </div>

      <div class="tf-form-footer">
        <button type="submit" class="tf-auth-btn" id="tfResetBtn">
          <span id="tfResetBtnTxt">Save new password</span>
          <span class="tf-btn-spinner" id="tfResetSpinner" style="display:none;"></span>
        </button>
        <a href="{{ routes.account_login_url }}" class="tf-auth-side-link tf-link-underline">Cancel</a>
      </div>
    {%- endform -%}
  </div>

  <div class="tf-auth-footer-notice">
    Need assistance? <a href="/pages/contact" style="color:inherit;text-decoration:underline;">Contact our support team</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function setupToggle(btnId, inputId, showSvgId, hideSvgId) {
    var btn = document.getElementById(btnId);
    var inp = document.getElementById(inputId);
    var show = document.getElementById(showSvgId);
    var hide = document.getElementById(hideSvgId);
    if (!btn || !inp) return;
    btn.addEventListener('click', function() {
      if (inp.type === 'password') {
        inp.type = 'text';
        if (show) show.style.display = 'none';
        if (hide) hide.style.display = 'block';
      } else {
        inp.type = 'password';
        if (show) show.style.display = 'block';
        if (hide) hide.style.display = 'none';
      }
    });
  }

  setupToggle('tfToggleResetPw', 'tfResetPw', 'tfEyeShow1', 'tfEyeHide1');
  setupToggle('tfToggleResetPwCfm', 'tfResetPwCfm', 'tfEyeShow2', 'tfEyeHide2');

  var form = document.getElementById('tfResetForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      var pw = document.getElementById('tfResetPw').value;
      var pwCfm = document.getElementById('tfResetPwCfm').value;
      var wrap1 = document.getElementById('tfResetPwWrap');
      var wrap2 = document.getElementById('tfResetPwCfmWrap');
      var valid = true;

      if (!pw || pw.length < 6) {
        wrap1.classList.add('tf-field-err');
        valid = false;
      } else {
        wrap1.classList.remove('tf-field-err');
      }

      if (pw !== pwCfm) {
        wrap2.classList.add('tf-field-err');
        valid = false;
      } else {
        wrap2.classList.remove('tf-field-err');
      }

      if (!valid) {
        e.preventDefault();
        return;
      }

      var btn = document.getElementById('tfResetBtn');
      var txt = document.getElementById('tfResetBtnTxt');
      var spin = document.getElementById('tfResetSpinner');
      if (btn) btn.disabled = true;
      if (txt) txt.textContent = 'Saving…';
      if (spin) spin.style.display = 'inline-block';
    });
  }
});
</script>

{% schema %}
{
  "name": "Reset Password",
  "tag": "section",
  "class": "section-auth-reset",
  "settings": []
}
{% endschema %}
