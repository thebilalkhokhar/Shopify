{{ 'home-follow-insta.css' | asset_url | stylesheet_tag }}

<section
  id="home-follow-insta-{{ section.id }}"
  class="home-follow-insta-section tapefox-dark-section"
  style="
    --hfi-bg-color: {{ section.settings.bg_color | default: '#171008' }};
    --hfi-btn-bg: {{ section.settings.btn_bg_color | default: '#ED632B' }};
    --hfi-btn-color: {{ section.settings.btn_text_color | default: '#171008' }};
    padding-top: {{ section.settings.padding_top | default: 50 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="hfi-container">
    <!-- Header -->
    <div class="hfi-header">
      <div class="hfi-header__left">
        {% if section.settings.badge_text != blank %}
          <div class="hfi-badge">{{ section.settings.badge_text }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hfi-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.button_text != blank %}
        <div class="hfi-header__right">
          <a
            href="{{ section.settings.button_url | default: 'https://instagram.com/tapefox' }}"
            class="hfi-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="hfi-btn__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </span>
            <span class="hfi-btn__text">{{ section.settings.button_text }}</span>
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Instagram Grid -->
    <div class="hfi-grid">
      {% for block in section.blocks %}
        {% liquid
          assign shape_idx = forloop.index0 | modulo: 6
          case shape_idx
            when 0
              assign shape_path = 'M 92,18 Q 100,13 108,18 L 168,52 Q 176,57 176,66 L 176,134 Q 176,143 168,148 L 108,182 Q 100,187 92,182 L 32,148 Q 24,143 24,134 L 24,66 Q 24,57 32,52 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&auto=format&fit=crop'
            when 1
              assign shape_path = 'M 100,10 Q 118,56 164,36 Q 144,82 190,100 Q 144,118 164,164 Q 118,144 100,190 Q 82,144 36,164 Q 56,118 10,100 Q 56,82 36,36 Q 118,56 100,10 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=600&auto=format&fit=crop'
            when 2
              assign shape_path = 'M 100,46 C 124,46 142,28 160,38 C 178,48 186,72 186,100 C 186,128 178,152 160,162 C 142,172 124,154 100,154 C 76,154 58,172 40,162 C 22,152 14,128 14,100 C 14,72 22,48 40,38 C 58,28 76,46 100,46 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1607344645866-009c320c5ab8?w=600&auto=format&fit=crop'
            when 3
              assign shape_path = 'M 100,24 C 109,8.4 126.7,12 129.1,29.8 C 143.4,18.9 158.4,28.9 153.7,46.3 C 171.1,41.6 181.1,56.6 170.2,70.9 C 188,73.3 191.6,91 176,100 C 191.6,109 188,126.7 170.2,129.1 C 181.1,143.4 171.1,158.4 153.7,153.7 C 158.4,171.1 143.4,181.1 129.1,170.2 C 126.7,188 109,191.6 100,176 C 91,191.6 73.3,188 70.9,170.2 C 56.6,181.1 41.6,171.1 46.3,153.7 C 28.9,158.4 18.9,143.4 29.8,129.1 C 12,126.7 8.4,109 24,100 C 8.4,91 12,73.3 29.8,70.9 C 18.9,56.6 28.9,41.6 46.3,46.3 C 41.6,28.9 56.6,18.9 70.9,29.8 C 73.3,12 91,8.4 100,24 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=600&auto=format&fit=crop'
            when 4
              assign shape_path = 'M 100,28 C 111,4.6 138.1,11.9 136,37.6 C 157.2,22.9 177.1,42.8 162.4,64 C 188.1,61.9 195.4,89 172,100 C 195.4,111 188.1,138.1 162.4,136 C 177.1,157.2 157.2,177.1 136,162.4 C 138.1,188.1 111,195.4 100,172 C 89,195.4 61.9,188.1 64,162.4 C 42.8,177.1 22.9,157.2 37.6,136 C 11.9,138.1 4.6,111 28,100 C 4.6,89 11.9,61.9 37.6,64 C 22.9,42.8 42.8,22.9 64,37.6 C 61.9,11.9 89,4.6 100,28 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1530587191325-3db32d826c18?w=600&auto=format&fit=crop'
            when 5
              assign shape_path = 'M 78,16 C 92,6 108,6 122,16 C 138,28 132,60 148,76 C 164,92 196,86 196,100 C 196,114 164,108 148,124 C 132,140 138,172 122,184 C 108,194 92,194 78,184 C 62,172 68,140 52,124 C 36,108 4,114 4,100 C 4,86 36,92 52,76 C 68,60 62,28 78,16 Z'
              assign fallback_img_url = 'https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=600&auto=format&fit=crop'
          endcase

          assign clip_id = 'hfi-clip-' | append: section.id | append: '-' | append: block.id
        %}

        <div class="hfi-item" {{ block.shopify_attributes }}>
          <a
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
              target="_blank"
              rel="noopener noreferrer"
            {% else %}
              href="{{ section.settings.button_url | default: 'https://instagram.com/tapefox' }}"
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
            class="hfi-item__link"
            aria-label="{{ block.settings.alt_text | default: 'Tape in the wild' }}"
          >
            {% if block.settings.image != blank %}
              <!-- Direct Shape Image uploaded by user -->
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.alt_text | default: 'Tape in the wild' }}"
                class="hfi-item__img"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% else %}
              <!-- Fallback preview before user uploads their shape image -->
              <div class="hfi-item__frame">
                <svg class="hfi-item__svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <clipPath id="{{ clip_id }}">
                      <path d="{{ shape_path }}" />
                    </clipPath>
                  </defs>
                  <image
                    href="{{ fallback_img_url }}"
                    x="0"
                    y="0"
                    width="200"
                    height="200"
                    preserveAspectRatio="xMidYMid slice"
                    clip-path="url(#{{ clip_id }})"
                  />
                  <path
                    d="{{ shape_path }}"
                    fill="none"
                    class="hfi-item__border"
                  />
                </svg>
              </div>
            {% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home Follow Insta",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Stuck on the internet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tape in the wild"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Follow @tapefox"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Instagram Profile Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#171008"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ED632B"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#171008"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 10,
      "max": 140,
      "step": 5,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "insta_item",
      "name": "Shape Image Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shape Image (PNG / WebP)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link (Optional)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Tape in the wild"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Follow Insta",
      "blocks": [
        { "type": "insta_item" },
        { "type": "insta_item" },
        { "type": "insta_item" },
        { "type": "insta_item" },
        { "type": "insta_item" },
        { "type": "insta_item" }
      ]
    }
  ]
}
{% endschema %}
