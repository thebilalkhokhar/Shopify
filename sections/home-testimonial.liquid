{{ 'home-testimonial.css' | asset_url | stylesheet_tag }}

<div class="home-testimonial-section tapefox-dark-section" {{ section.shopify_attributes }}>
  <div class="home-testimonial__card">
    <!-- Top Black Circles (Punch holes) -->
    <div class="home-testimonial__punches" id="homeTestimonialPunches-{{ section.id }}" aria-hidden="true">
      {% for i in (1..20) %}
        <span class="home-testimonial__punch-dot"></span>
      {% endfor %}
    </div>

    <!-- Header Row -->
    <div class="home-testimonial__header">
      <div class="home-testimonial__header-left">
        {% if section.settings.badge_text != blank %}
          <div class="home-testimonial__badge">{{ section.settings.badge_text }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="home-testimonial__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      <div class="home-testimonial__header-right">
        {% if section.settings.logo_image != blank %}
          <img
            src="{{ section.settings.logo_image | image_url: width: 180 }}"
            alt="TapeFox"
            width="120"
            height="auto"
            loading="lazy"
            class="home-testimonial__brand-logo"
          >
        {% else %}
          <!-- Tapefox Brand Mark SVG -->
          <div class="home-testimonial__brand-mark">
            <svg viewBox="0 0 100 65" width="85" height="55" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Fox icon head -->
              <path d="M50 8l-8 14h16l-8-14z" fill="#E85D18"/>
              <path d="M42 22l8 12 8-12-8-3-8 3z" fill="#E85D18"/>
              <path d="M38 12l4 10-6 4 2-14z" fill="#E85D18"/>
              <path d="M62 12l-4 10 6 4-2-14z" fill="#E85D18"/>
              <!-- TapeFox wordmark -->
              <text x="50" y="55" text-anchor="middle" font-family="'Bringbold Nineties', serif" font-size="16" font-weight="700" fill="#E85D18">TapeFox</text>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Slider Area -->
    <div class="home-testimonial__slider-wrap">
      <div class="home-testimonial__slider-track" id="homeTestimonialTrack-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="home-testimonial__slide" {{ block.shopify_attributes }}>
            <div class="home-testimonial__item-card">
              <!-- 5 Stars -->
              <div class="home-testimonial__stars" aria-label="5 out of 5 stars">
                {% for star in (1..5) %}
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="#E85D18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L10 1.5z"/>
                  </svg>
                {% endfor %}
              </div>

              <!-- Quote Title -->
              {% if block.settings.title != blank %}
                <h3 class="home-testimonial__item-title">{{ block.settings.title }}</h3>
              {% endif %}

              <!-- Review Text -->
              {% if block.settings.text != blank %}
                <p class="home-testimonial__item-text">{{ block.settings.text }}</p>
              {% endif %}

              <!-- Dashed Divider -->
              <div class="home-testimonial__divider"></div>

              <!-- Author / Subtitle -->
              {% if block.settings.author != blank %}
                <div class="home-testimonial__author">{{ block.settings.author }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Controls Row (Progress Bar & Arrow Navigation) -->
    <div class="home-testimonial__controls">
      <!-- Progress Bar Track -->
      <div class="home-testimonial__progress-wrap">
        <div class="home-testimonial__progress-bar" id="homeTestimonialProgress-{{ section.id }}"></div>
      </div>

      <!-- Arrow Buttons -->
      <div class="home-testimonial__nav-btns">
        <button
          type="button"
          class="home-testimonial__nav-btn prev"
          id="homeTestimonialPrev-{{ section.id }}"
          aria-label="Previous testimonials"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="#171008"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          class="home-testimonial__nav-btn next"
          id="homeTestimonialNext-{{ section.id }}"
          aria-label="Next testimonials"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="#171008"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initTestimonials() {
      const punchContainer = document.getElementById('homeTestimonialPunches-{{ section.id }}');
      const track = document.getElementById('homeTestimonialTrack-{{ section.id }}');
      const prevBtn = document.getElementById('homeTestimonialPrev-{{ section.id }}');
      const nextBtn = document.getElementById('homeTestimonialNext-{{ section.id }}');
      const progress = document.getElementById('homeTestimonialProgress-{{ section.id }}');

      // 1. Dynamic Punch Holes calculation so zero circles are ever cut off
      function renderPunches() {
        if (!punchContainer) return;
        const width = punchContainer.clientWidth;
        if (!width) return;

        const isMobile = window.innerWidth <= 600;
        const dotSize = isMobile ? 14 : 24; // Large 24px punch circles
        const minGap = isMobile ? 12 : 24;

        // Calculate count that fits completely without any clipping
        let count = Math.floor((width + minGap) / (dotSize + minGap));
        count = Math.max(3, count);

        // Build dots
        const fragment = document.createDocumentFragment();
        for (let i = 0; i < count; i++) {
          const dot = document.createElement('span');
          dot.className = 'home-testimonial__punch-dot';
          fragment.appendChild(dot);
        }
        punchContainer.innerHTML = '';
        punchContainer.appendChild(fragment);
      }

      // 2. Seamless Infinite Marquee + Progress Bar + Prev/Next Buttons
      const originalSlides = track ? Array.from(track.querySelectorAll('.home-testimonial__slide')) : [];
      const originalCount = originalSlides.length;
      let loopWidth = 0;
      let isPaused = false;
      let manualScrollTimer = null;
      let rafId = null;
      let lastTime = 0;

      if (track && originalCount > 0 && !track.dataset.marqueeInit) {
        track.dataset.marqueeInit = 'true';
        originalSlides.forEach(function (slide) {
          const clone = slide.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.dataset.cloned = 'true';
          track.appendChild(clone);
        });
      }

      function computeLoopWidth() {
        if (!track || originalCount === 0) {
          loopWidth = 0;
          return;
        }
        const firstOriginal = track.children[0];
        const firstClone = track.children[originalCount];
        if (firstOriginal && firstClone) {
          loopWidth = firstClone.offsetLeft - firstOriginal.offsetLeft;
        }
      }

      function updateProgress() {
        if (!progress || !track || originalCount === 0) return;

        if (loopWidth <= 0) {
          progress.style.width = '100%';
          return;
        }

        const posInLoop = ((track.scrollLeft % loopWidth) + loopWidth) % loopWidth;
        const minPercent = Math.max(15, Math.min(30, Math.round((1 / originalCount) * 100)));
        const ratio = Math.max(0, Math.min(1, posInLoop / loopWidth));
        const currentPercent = minPercent + ratio * (100 - minPercent);

        progress.style.width = Math.min(100, Math.max(minPercent, currentPercent)).toFixed(1) + '%';
      }

      function pauseForManualAction() {
        isPaused = true;
        clearTimeout(manualScrollTimer);
        manualScrollTimer = setTimeout(function () {
          isPaused = false;
        }, 1200);
      }

      // Continuous smooth marquee loop (~38px/sec)
      function marqueeTick(now) {
        if (!lastTime) lastTime = now;
        const dt = Math.min(50, now - lastTime);
        lastTime = now;

        if (track && loopWidth > 0 && !isPaused) {
          track.scrollLeft += (38 * dt) / 1000;
          if (track.scrollLeft >= loopWidth) {
            track.scrollLeft -= loopWidth;
          }
          updateProgress();
        }

        rafId = requestAnimationFrame(marqueeTick);
      }

      // Next button (seamless forward)
      if (nextBtn && track) {
        nextBtn.addEventListener('click', function () {
          pauseForManualAction();
          const slide = track.querySelector('.home-testimonial__slide');
          const scrollAmount = slide ? slide.offsetWidth + 20 : 380;

          if (loopWidth > 0 && track.scrollLeft >= loopWidth) {
            track.scrollLeft -= loopWidth;
          }
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }

      // Prev button (seamless backward)
      if (prevBtn && track) {
        prevBtn.addEventListener('click', function () {
          pauseForManualAction();
          const slide = track.querySelector('.home-testimonial__slide');
          const scrollAmount = slide ? slide.offsetWidth + 20 : 380;

          if (loopWidth > 0 && track.scrollLeft - scrollAmount < 0) {
            track.scrollLeft += loopWidth;
          }
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
      }

      if (track) {
        track.addEventListener('mouseenter', function () { isPaused = true; });
        track.addEventListener('mouseleave', function () { isPaused = false; });
        track.addEventListener('touchstart', function () { isPaused = true; }, { passive: true });
        track.addEventListener('touchend', function () {
          clearTimeout(manualScrollTimer);
          manualScrollTimer = setTimeout(function () { isPaused = false; }, 1200);
        }, { passive: true });
        track.addEventListener('scroll', updateProgress, { passive: true });
      }

      renderPunches();
      computeLoopWidth();
      updateProgress();
      rafId = requestAnimationFrame(marqueeTick);

      let resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          renderPunches();
          computeLoopWidth();
          updateProgress();
        }, 100);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestimonials);
    } else {
      initTestimonials();
    }
  })();
</script>

{% schema %}
{
  "name": "Home Testimonial",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Received"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What buyers said."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Brand Logo (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Heading",
          "default": "Boxes look like packages now"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "We shipped in plain brown cartons and kept getting mistaken for a drop-shipper. Three-colour poly fixed that for less than we spend on bubble wrap."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author & Business",
          "default": "Dana Whitfield · Subscription coffee"
        }
      ]
    }
  ],
  "presets": [
    {
