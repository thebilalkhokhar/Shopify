          "id": "text",
          "label": "Review Text",
          "default": "We shipped in plain brown cartons and kept getting mistaken for a drop-shipper. Three-colour poly fixed that for less than we spend on bubble wrap."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Dana Whitfield"
        },
        {
          "type": "text",
          "id": "author_handle",
          "label": "Author Business / Role",
          "default": "Subscription coffee"
        }
      ]
    }
  ],
  "presets": [
