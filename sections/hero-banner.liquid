      "label": "Slider Image 1 (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "slider_image_2",
      "label": "Slider Image 2 (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "slider_image_2_tablet",
      "label": "Slider Image 2 (Tablet)"
    },
    {
      "type": "image_picker",
      "id": "slider_image_2_mobile",
      "label": "Slider Image 2 (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "slider_image_3",
      "label": "Slider Image 3 (Desktop)"
    },
    {
