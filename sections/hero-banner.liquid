      "id": "button_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 Label",
      "default": "Get Sample"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price Text",
      "default": "Starting from $5.68 a roll"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image_1",
      "label": "Thumbnail 1"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image_2",
      "label": "Thumbnail 2"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image_3",
