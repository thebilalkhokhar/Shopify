{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<div class="hero-banner-overlay" {{ section.shopify_attributes }}>
  <!-- Background Images Slider -->
  <div class="hero-banner__bg">
    {% assign slide_count = 0 %}

    {% if section.settings.slider_image_1 != blank %}
      {% assign slide_count = slide_count | plus: 1 %}
      <div class="hero-banner__slide {% if slide_count == 1 %}active{% endif %}">
        <picture>
          {% if section.settings.slider_image_1_tablet != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.slider_image_1_tablet | image_url: width: 1200 }}">
          {% elsif section.settings.tablet_image != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.tablet_image | image_url: width: 1200 }}">
          {% endif %}
          {% if section.settings.slider_image_1_mobile != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.slider_image_1_mobile | image_url: width: 800 }}">
          {% elsif section.settings.mobile_image != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
          {% endif %}
          <img
            src="{{ section.settings.slider_image_1 | image_url: width: 1920 }}"
            width="1920"
            height="auto"
            alt="Banner Background 1"
            class="bg-img"
          >
        </picture>
      </div>
    {% endif %}

    {% if section.settings.slider_image_2 != blank %}
      {% assign slide_count = slide_count | plus: 1 %}
      <div class="hero-banner__slide {% if slide_count == 1 %}active{% endif %}">
        <picture>
          {% if section.settings.slider_image_2_tablet != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.slider_image_2_tablet | image_url: width: 1200 }}">
          {% elsif section.settings.tablet_image != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.tablet_image | image_url: width: 1200 }}">
          {% endif %}
          {% if section.settings.slider_image_2_mobile != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.slider_image_2_mobile | image_url: width: 800 }}">
          {% elsif section.settings.mobile_image != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
          {% endif %}
          <img
            src="{{ section.settings.slider_image_2 | image_url: width: 1920 }}"
            width="1920"
            height="auto"
            alt="Banner Background 2"
            class="bg-img"
          >
        </picture>
      </div>
    {% endif %}

    {% if section.settings.slider_image_3 != blank %}
      {% assign slide_count = slide_count | plus: 1 %}
      <div class="hero-banner__slide {% if slide_count == 1 %}active{% endif %}">
        <picture>
          {% if section.settings.slider_image_3_tablet != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.slider_image_3_tablet | image_url: width: 1200 }}">
          {% elsif section.settings.tablet_image != blank %}
            <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.tablet_image | image_url: width: 1200 }}">
          {% endif %}
          {% if section.settings.slider_image_3_mobile != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.slider_image_3_mobile | image_url: width: 800 }}">
          {% elsif section.settings.mobile_image != blank %}
            <source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
          {% endif %}
          <img
            src="{{ section.settings.slider_image_3 | image_url: width: 1920 }}"
            width="1920"
            height="auto"
            alt="Banner Background 3"
            class="bg-img"
          >
        </picture>
      </div>
    {% endif %}

    {% if slide_count == 0 %}
      <!-- Fallback if no slider images are added -->
      <div class="hero-banner__slide active">
        {% if section.settings.desktop_image != blank %}
          <picture>
            {% if section.settings.tablet_image != blank %}
              <source media="(min-width: 601px) and (max-width: 991px)" srcset="{{ section.settings.tablet_image | image_url: width: 1200 }}">
            {% endif %}
            {% if section.settings.mobile_image != blank %}
              <source media="(max-width: 600px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
            {% endif %}
            <img
              src="{{ section.settings.desktop_image | image_url: width: 1920 }}"
              width="1920"
              height="auto"
              alt="Banner Background"
              class="bg-img"
            >
          </picture>
        {% else %}
          <div class="placeholder-bg">Upload Slider Image 1</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <!-- Text Overlay -->
  <div class="hero-banner__overlay-content">
    <div class="hero-banner__container hero-banner__flex">
      <div class="hero-banner__text-box">
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
        <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>

        <div class="hero-banner__buttons">
          {% if section.settings.button_1_label != blank %}
            <a href="{{ section.settings.button_1_link }}" class="btn btn--primary">
              {{- section.settings.button_1_label -}}
            </a>
          {% endif %}
          {% if section.settings.button_2_label != blank %}
            <a href="{{ section.settings.button_2_link }}" class="btn btn--secondary">
              {{- section.settings.button_2_label -}}
            </a>
          {% endif %}
        </div>

        {% if section.settings.price_text != blank %}
          <p class="hero-banner__price">{{ section.settings.price_text }}</p>
        {% endif %}
      </div>

      <!-- Additional Thumbnails if needed -->
      <div class="hero-banner__thumbnails desktop-only">
        {% for i in (1..3) %}
          {% capture thumb_setting %}thumbnail_image_{{ i }}{% endcapture %}
          {% assign thumb = section.settings[thumb_setting] %}
          {% if thumb != blank %}
            <img
              src="{{ thumb | image_url: width: 100 }}"
              width="100"
              height="auto"
              alt="Thumbnail {{ i }}"
              class="hero-banner__thumb"
            >
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="hero-banner__footer">
    <div class="hero-banner__container">
      <span class="hero-banner__footer-left">{{ section.settings.bottom_left_text }}</span>
      <span class="hero-banner__footer-right">{{ section.settings.bottom_right_text }}</span>
    </div>
  </div>
</div>

