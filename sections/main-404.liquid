{{ 'page-404.css' | asset_url | stylesheet_tag }}

<section
  id="page-404-{{ section.id }}"
  class="page-404-section"
  style="
    --p404-card-bg: {{ section.settings.card_bg | default: '#EA5B1B' }};
    --p404-card-border: {{ section.settings.card_border | default: '#171008' }};
    {% if request.path contains '/blogs/news/' and request.path != '/blogs/news' and request.path != '/blogs/news/' %}display: none !important;{% endif %}
    {% if request.path contains '/login' or request.path contains '/account' or request.path contains '/checkout' or request.path contains '/order-sample' or request.path contains '/privacy' or request.path contains '/terms' or request.path contains '/shipping' or request.path contains '/refund' or request.path contains '/returns' or request.path contains '/damages' or request.path contains '/turnaround' or request.path contains '/accessibility' %}display: none !important;{% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="page-404-container">
    
    <!-- Top Left Tape Strip -->
    <div class="page-404-tape page-404-tape-top-left" aria-hidden="true"></div>
    
    <!-- Bottom Right Tape Strip -->
    <div class="page-404-tape page-404-tape-bottom-right" aria-hidden="true"></div>

    <!-- Main Branded 404 Hero Card -->
    <div class="page-404-card">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="page-404-content">
        <div class="page-404-badge-row">
          {% if section.settings.badge_text != blank %}
            <span class="page-404-badge">{{ section.settings.badge_text }}</span>
          {% endif %}
          <span class="page-404-sparkles" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="#171008">
              <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5L12 0Z"/>
            </svg>
          </span>
        </div>

        <div class="page-404-number">{{ section.settings.error_code | default: '404' }}</div>

        <h1 class="page-404-title">
          {{ section.settings.heading | default: 'Looks like this roll got tangled up.' }}
        </h1>

        <div class="page-404-desc">
          {% if section.settings.subheading != blank %}
            {{ section.settings.subheading }}
          {% else %}
            <p>The page you're looking for doesn't exist, was moved, or got sealed into the wrong carton. Let's get you back on track!</p>
          {% endif %}
        </div>

        <!-- Action Button -->
        <div class="page-404-actions">
          <a href="{{ section.settings.primary_btn_link | default: routes.root_url }}" class="page-404-btn-primary">
            <span>{{ section.settings.primary_btn_text | default: 'Back to Home' }}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Fox Mascot -->
      <div class="page-404-illustration">
        {% if section.settings.fox_image != blank %}
          <img
            src="{{ section.settings.fox_image | image_url: width: 700 }}"
            alt="{{ section.settings.fox_image.alt | default: 'TapeFox Lost Mascot' }}"
            class="page-404-fox-img"
            width="{{ section.settings.fox_width | default: 340 }}"
            height="auto"
            loading="eager"
          >
        {% else %}
          <div class="page-404-fox-fallback">
            <span class="page-404-fox-icon">🦊</span>
            <span style="font-size: 13px; font-weight: 700; color: #171008;">Lost TapeFox</span>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    var path = window.location.pathname.toLowerCase();
    if (
      (path.indexOf('/blogs/news/') !== -1 && path !== '/blogs/news' && path !== '/blogs/news/') ||
      path.indexOf('/login') !== -1 ||
      path.indexOf('/account') !== -1 ||
      path.indexOf('/checkout') !== -1 ||
      path.indexOf('/order-sample') !== -1 ||
      path.indexOf('/privacy') !== -1 ||
      path.indexOf('/terms') !== -1 ||
      path.indexOf('/shipping') !== -1 ||
      path.indexOf('/refund') !== -1 ||
      path.indexOf('/returns') !== -1 ||
      path.indexOf('/damages') !== -1 ||
      path.indexOf('/turnaround') !== -1 ||
      path.indexOf('/accessibility') !== -1
    ) {
      var p404Section = document.getElementById('page-404-{{ section.id }}');
      if (p404Section) p404Section.style.display = 'none';
    }
  })();
</script>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#EA5B1B"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border Color",
      "default": "#171008"
    },
    {
      "type": "header",
      "content": "Illustration / Mascot"
    },
    {
      "type": "image_picker",
      "id": "fox_image",
      "label": "Fox Mascot Image"
    },
    {
      "type": "range",
      "id": "fox_width",
      "label": "Fox Width (px)",
      "min": 180,
      "max": 500,
      "step": 10,
      "default": 340,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Lost in transit"
    },
    {
      "type": "text",
      "id": "error_code",
      "label": "Error Code",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Looks like this roll got tangled up."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>The page you're looking for doesn't exist, was moved, or got sealed into the wrong carton. Let's get you back on track!</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Back to Home"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "Read Our Blogs"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "404 Page"
    }
  ]
}
{% endschema %}
