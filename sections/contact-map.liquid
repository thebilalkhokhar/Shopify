{{ 'contact-map.css' | asset_url | stylesheet_tag }}

<section
  id="contact-map-{{ section.id }}"
  class="contact-map-section"
  style="
    --cmap-bg: {{ section.settings.bg_color | default: '#171008' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="contact-map-outer">
    
    <!-- Top Header Area (Find us badge + Find us on the map heading + description) -->
    <div class="contact-map-header">
      {% if section.settings.badge_text != blank %}
        <div class="contact-map-badge-wrap">
          <span class="contact-map-badge">{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="contact-map-title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="contact-map-desc">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <div class="contact-map-frame">
      
      <!-- Vector Map Graphic Illustration -->
      <div class="contact-map-svg-wrap" aria-hidden="true">
        <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" class="contact-map-svg">
          <defs>
            <!-- Railroad track pattern -->
            <pattern id="railPattern" width="16" height="20" patternUnits="userSpaceOnUse">
              <line x1="0" y1="10" x2="16" y2="10" stroke="#FF9933" stroke-width="2" />
              <line x1="8" y1="2" x2="8" y2="18" stroke="#FF9933" stroke-width="2" />
            </pattern>
          </defs>

          <!-- Solid Orange Background -->
          <rect width="100%" height="100%" fill="#E35205" />

          <!-- Blocks / Plots grid lines -->
          <g stroke="#D44700" stroke-width="1.5" fill="none">
            <!-- Left grid plots -->
            <rect x="40" y="240" width="100" height="70" />
            <rect x="40" y="320" width="100" height="70" />
            <rect x="40" y="400" width="100" height="70" />
            <rect x="40" y="480" width="100" height="70" />

            <rect x="150" y="240" width="100" height="70" />
            <rect x="150" y="320" width="100" height="70" />
            <rect x="150" y="400" width="100" height="70" />
            <rect x="150" y="480" width="100" height="70" />

            <!-- Middle-left plots -->
            <rect x="325" y="300" width="110" height="60" rx="4" />
            <rect x="325" y="420" width="110" height="65" rx="4" />
            <rect x="325" y="520" width="110" height="55" rx="4" />

            <!-- Large middle plots -->
            <rect x="550" y="300" width="180" height="110" rx="4" />
            <rect x="550" y="450" width="180" height="100" rx="4" />

            <!-- Large right plots -->
            <rect x="795" y="300" width="120" height="110" rx="4" />
            <rect x="795" y="450" width="120" height="100" rx="4" />
          </g>

          <!-- Railroad track on top -->
          <rect x="0" y="140" width="1200" height="20" fill="url(#railPattern)" />

          <!-- Highway US-59 / I-69 Angled Dashed Road on Top Right -->
          <path d="M 820 180 L 1200 60" stroke="#FFCC00" stroke-width="4" stroke-dasharray="8,6" fill="none" />
          <path d="M 830 190 L 1200 70" stroke="#FFCC00" stroke-width="2" stroke-dasharray="8,6" fill="none" opacity="0.8" />
          <text x="860" y="150" fill="#FFCC00" font-size="13" font-family="'Inter', sans-serif" font-weight="700" letter-spacing="0.5">US-59 / I-69</text>

          <!-- Union Pacific Label on Top Left -->
          <text x="25" y="130" fill="#FFCC00" font-size="13" font-family="'Inter', sans-serif" font-weight="700">▲ Union Pacific</text>
          <line x1="0" y1="165" x2="1200" y2="165" stroke="#FFCC00" stroke-width="2" stroke-dasharray="6,4" />

          <!-- Vertical Road: Cottonwood School Rd (Yellow Solid Main Road) -->
          <rect x="300" y="165" width="8" height="435" fill="#FFCC00" />
          <text x="308" y="540" fill="#E35205" font-size="11" font-family="'Inter', sans-serif" font-weight="700" transform="rotate(-90 308,540)">Cottonwood School Rd</text>

          <!-- Vertical Road: B F Terry Blvd -->
          <rect x="520" y="240" width="5" height="360" fill="#FF9933" opacity="0.9" />
          <text x="525" y="540" fill="#E35205" font-size="11" font-family="'Inter', sans-serif" font-weight="700" transform="rotate(-90 525,540)">B F Terry Blvd</text>

          <!-- Vertical Dashed Road: TX-36 S on the right -->
          <line x1="760" y1="175" x2="760" y2="600" stroke="#FFCC00" stroke-width="5" stroke-dasharray="10,6" />
          <text x="768" y="540" fill="#FFCC00" font-size="11" font-family="'Inter', sans-serif" font-weight="700" transform="rotate(-90 768,540)">TX-36 S</text>

          <!-- Horizontal Road: Klauke Rd -->
          <rect x="0" y="280" width="760" height="4" fill="#FF9933" />
          <text x="462" y="272" fill="#FF9933" font-size="12" font-family="'Inter', sans-serif" font-weight="700">Klauke Rd</text>

          <!-- Brazos River on the far right edge -->
          <path d="M 985 140 Q 950 250 970 380 T 965 600 L 1020 600 L 1020 140 Z" fill="#D44700" opacity="0.6" />
          <text x="945" y="490" fill="#FF9933" font-size="11" font-family="'Inter', sans-serif" font-weight="600" transform="rotate(-90 945,490)">Brazos River</text>
        </svg>
      </div>

      <!-- BLDG 3 Marker Pin on Map -->
      <div class="contact-map-pin-group">
        <!-- Sunburst / Starburst Pin Icon -->
        <div class="contact-map-starburst" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="contact-map-burst-svg">
            <path
              d="M50 0 L58 24 L82 10 L75 35 L100 42 L80 58 L95 80 L70 80 L65 100 L50 85 L35 100 L30 80 L5 80 L20 58 L0 42 L25 35 L18 10 L42 24 Z"
              fill="#F8B825"
              stroke="#171008"
              stroke-width="5"
              stroke-linejoin="round"
            />
            <circle cx="50" cy="50" r="14" fill="#171008" />
          </svg>
        </div>

        <!-- BLDG 3 Badge -->
        <div class="contact-map-bldg-badge">
          <span>{{ section.settings.bldg_label | default: 'BLDG 3' }}</span>
        </div>
      </div>

      <!-- Floating Address Information Card -->
      <div class="contact-map-info-card">
        
        <!-- Address Block -->
        <div class="cmap-card-section">
          <span class="cmap-card-label">{{ section.settings.address_label | default: 'ADDRESS' }}</span>
          <div class="cmap-card-address-lines">
            <strong>{{ section.settings.title | default: 'Tapefox Printing' }}</strong><br>
            {{ section.settings.address_line1 | default: '1631 Cottonwood School Rd,' }}<br>
            {{ section.settings.address_line2 | default: 'Building 3 Rosenberg, TX 77471' }}
          </div>
        </div>

        <!-- Hours Block -->
        <div class="cmap-card-section">
          <span class="cmap-card-label">{{ section.settings.hours_label | default: 'HOURS' }}</span>
          <div class="cmap-card-value">
            {{ section.settings.hours_text | default: 'Mon–Fri · 8:00 – 18:00 CT' }}
          </div>
        </div>

        <!-- Phone Block -->
        <div class="cmap-card-section">
          <span class="cmap-card-label">{{ section.settings.phone_label | default: 'PHONE' }}</span>
          <a href="tel:{{ section.settings.phone_number | default: '+18005550199' }}" class="cmap-card-phone-link">
            {{ section.settings.phone_number | default: '+1 (800) 555-0199' }}
          </a>
        </div>

        <!-- Get Directions Action Button -->
        <a
          href="{{ section.settings.directions_url | default: 'https://www.google.com/maps/search/?api=1&query=1631+Cottonwood+School+Rd+Building+3+Rosenberg+TX+77471' }}"
          target="_blank"
          rel="noopener noreferrer"
          class="cmap-card-btn"
        >
          <svg class="cmap-btn-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>{{ section.settings.btn_label | default: 'Get directions' }}</span>
        </a>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Map Section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Outer Background",
      "default": "#171008"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Find us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find us on the map"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Everything is printed, slit and boxed in one building. Come and see the press if you are passing call first, the dock is not always staffed."
    },
    {
      "type": "text",
      "id": "bldg_label",
      "label": "Building Pin Label",
      "default": "BLDG 3"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Address Heading Label",
      "default": "ADDRESS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Company Title",
      "default": "Tapefox Printing"
    },
    {
      "type": "text",
      "id": "address_line1",
      "label": "Address Line 1",
      "default": "1631 Cottonwood School Rd,"
    },
    {
      "type": "text",
      "id": "address_line2",
      "label": "Address Line 2",
      "default": "Building 3 Rosenberg, TX 77471"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours Heading Label",
      "default": "HOURS"
    },
    {
      "type": "text",
      "id": "hours_text",
      "label": "Hours Description",
      "default": "Mon–Fri · 8:00 – 18:00 CT"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Heading Label",
      "default": "PHONE"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+1 (800) 555-0199"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions URL (Google Maps)",
      "info": "Leave empty for default coordinates"
    }
  ],
  "presets": [
    {
      "name": "Contact Map Section"
    }
  ]
}
{% endschema %}
