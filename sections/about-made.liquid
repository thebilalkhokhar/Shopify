          "id": "description",
          "label": "Step Description",
          "default": "<p>A print-ready PDF, or a logo and a sentence about what you want. Our studio redraws anything that will not hold up at speed.</p>"
        },
        {
          "type": "text",
          "id": "pill_text",
          "label": "Bottom Pill Tag",
          "default": "Free, always"
        }
      ]
    }
  ],
  "presets": [
