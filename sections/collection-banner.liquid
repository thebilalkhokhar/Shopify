{{ 'collection-banner.css' | asset_url | stylesheet_tag }}

<section
  id="collection-banner-{{ section.id }}"
  class="collection-banner-section"
  style="
    background-color: {{ section.settings.bg_color | default: 'transparent' }};
    --cb-pt: {{ section.settings.padding_top | default: 230 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="cb-container">
    <div class="cb-content">
      {%- assign title_to_show = section.settings.heading -%}
      {%- if title_to_show == blank and collection.title != blank -%}
        {%- assign title_to_show = collection.title -%}
      {%- endif -%}

      {%- if title_to_show != blank -%}
        <h1 class="cb-title">{{ title_to_show }}</h1>
      {%- endif -%}

      {%- assign desc_to_show = section.settings.subheading -%}
      {%- if desc_to_show == blank and collection.description != blank -%}
        {%- assign desc_to_show = collection.description -%}
      {%- endif -%}

      {%- if desc_to_show != blank -%}
        <div class="cb-description">
          {{ desc_to_show }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F3ED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products",
      "info": "Leave empty to use Collection Title automatically"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>Premium printed tape for packaging, projects, and ideas that deserve more than the ordinary.</p>",
      "info": "Leave empty to use Collection Description automatically"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 40,
      "max": 240,
      "step": 5,
      "default": 230,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 30,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
