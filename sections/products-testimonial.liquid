{{ 'products-testimonial.css' | asset_url | stylesheet_tag }}

<div class="products-testimonial-section" {{ section.shopify_attributes }}>
  <div class="products-testimonial__card">

    <!-- Header Row -->
    <div class="products-testimonial__header">
      <div class="products-testimonial__header-left">
        {% if section.settings.badge_text != blank %}
          <div class="products-testimonial__badge">{{ section.settings.badge_text }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="products-testimonial__title">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      <div class="products-testimonial__header-right">
        {% if section.settings.logo_image != blank %}
          <img
            src="{{ section.settings.logo_image | image_url: width: 180 }}"
            alt="TapeFox"
            width="120"
            height="auto"
            loading="lazy"
            class="products-testimonial__brand-logo"
          >
        {% else %}
          <!-- Tapefox Brand Mark SVG -->
          <div class="products-testimonial__brand-mark">
            <svg viewBox="0 0 100 65" width="85" height="55" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M50 8l-8 14h16l-8-14z" fill="#E85D18"/>
              <path d="M42 22l8 12 8-12-8-3-8 3z" fill="#E85D18"/>
              <path d="M38 12l4 10-6 4 2-14z" fill="#E85D18"/>
              <path d="M62 12l-4 10 6 4-2-14z" fill="#E85D18"/>
              <text x="50" y="55" text-anchor="middle" font-family="'Bringbold Nineties', serif" font-size="16" font-weight="700" fill="#E85D18">TapeFox</text>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Slider Area -->
    <div class="products-testimonial__slider-wrap">
      <div class="products-testimonial__slider-track" id="productsTestimonialTrack-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="products-testimonial__slide" {{ block.shopify_attributes }}>
            <div class="products-testimonial__item-card">
              
              <!-- 5 Stars -->
              <div class="products-testimonial__stars" aria-label="5 out of 5 stars">
                {% for star in (1..5) %}
                  <svg viewBox="0 0 20 20" width="16" height="16" fill="#E85D18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L10 1.5z"/>
                  </svg>
                {% endfor %}
              </div>

              <!-- Quote Title -->
              {% if block.settings.title != blank %}
                <h3 class="products-testimonial__item-title">{{ block.settings.title }}</h3>
              {% endif %}

              <!-- Review Text -->
              {% if block.settings.text != blank %}
                <p class="products-testimonial__item-text">{{ block.settings.text }}</p>
              {% endif %}

              <!-- Dotted Divider -->
              <div class="products-testimonial__divider"></div>

              <!-- Author / Subtitle -->
              {% if block.settings.author != blank %}
                <div class="products-testimonial__author">{{ block.settings.author }}</div>
              {% endif %}

            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Controls Row (Progress Bar & Arrow Navigation) -->
    <div class="products-testimonial__controls">
      <!-- Progress Bar Track -->
      <div class="products-testimonial__progress-wrap">
        <div class="products-testimonial__progress-bar" id="productsTestimonialProgress-{{ section.id }}"></div>
      </div>

      <!-- Arrow Buttons -->
      <div class="products-testimonial__nav-btns">
        <button
          type="button"
          class="products-testimonial__nav-btn prev"
          id="productsTestimonialPrev-{{ section.id }}"
          aria-label="Previous testimonials"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#171008" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          class="products-testimonial__nav-btn next"
          id="productsTestimonialNext-{{ section.id }}"
          aria-label="Next testimonials"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#171008" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    function initProductsTestimonials() {
      const track = document.getElementById('productsTestimonialTrack-{{ section.id }}');
      const prevBtn = document.getElementById('productsTestimonialPrev-{{ section.id }}');
      const nextBtn = document.getElementById('productsTestimonialNext-{{ section.id }}');
      const progress = document.getElementById('productsTestimonialProgress-{{ section.id }}');

      // Accurate Progress Bar working according to cards
      function updateProgress() {
        if (!progress || !track) return;
        const slides = track.querySelectorAll('.products-testimonial__slide');
        if (!slides.length) return;

        const totalSlides = slides.length;
        const maxScroll = track.scrollWidth - track.clientWidth;

        if (maxScroll <= 8) {
          progress.style.width = '100%';
          return;
        }

        const scrollPos = track.scrollLeft;
        const lastSlide = slides[totalSlides - 1];
        const lastRect = lastSlide.getBoundingClientRect();
        const trackRect = track.getBoundingClientRect();

        // If at the end or last slide is in full view -> exactly 100%
        if (scrollPos >= maxScroll - 20 || lastRect.right <= trackRect.right + 20) {
          progress.style.width = '100%';
          return;
        }

        // Proportional progress from starting percentage to 100%
        const initialPercent = Math.max(20, Math.min(30, Math.round((1 / totalSlides) * 100)));
        const scrollRatio = Math.max(0, Math.min(1, scrollPos / maxScroll));
        const currentPercent = initialPercent + scrollRatio * (100 - initialPercent);

        progress.style.width = Math.min(100, Math.max(initialPercent, Math.round(currentPercent))) + '%';
      }

      // Next button
      if (nextBtn && track) {
        nextBtn.addEventListener('click', function() {
          const slides = track.querySelectorAll('.products-testimonial__slide');
          const slide = slides[0];
          const scrollAmount = slide ? slide.offsetWidth + 20 : 380;
          const maxScroll = track.scrollWidth - track.clientWidth;

          if (track.scrollLeft + scrollAmount >= maxScroll - 25) {
            track.scrollTo({ left: maxScroll, behavior: 'smooth' });
            if (progress) progress.style.width = '100%';
          } else {
            track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
          }
        });
      }

      // Prev button
      if (prevBtn && track) {
        prevBtn.addEventListener('click', function() {
          const slides = track.querySelectorAll('.products-testimonial__slide');
          const slide = slides[0];
          const scrollAmount = slide ? slide.offsetWidth + 20 : 380;

          if (track.scrollLeft - scrollAmount <= 25) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
          }
        });
      }

      if (track) {
        track.addEventListener('scroll', updateProgress, { passive: true });
        track.addEventListener('scrollend', updateProgress);
      }

      updateProgress();

      let resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          updateProgress();
        }, 100);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductsTestimonials);
    } else {
      initProductsTestimonials();
    }
  })();
</script>

{% schema %}
{
  "name": "Products Testimonial",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Received"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What buyers said."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Brand Logo (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Heading",
          "default": "Boxes look like packages now"
        },
        {
          "type": "textarea",
          "id": "text",
