{{ 'compare-table.css' | asset_url | stylesheet_tag }}

<section
  id="compare-table-{{ section.id }}"
  class="compare-page-section"
  style="
    --cp-page-bg: {{ section.settings.page_bg | default: '#F6F3EE' }};
  "
  {{ section.shopify_attributes }}
>
  <!-- Hero / Header Title Area -->
  <div class="compare-hero-header">
    {% if section.settings.badge_text != blank %}
      <div class="compare-badge-pill">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="compare-hero-title">
        {{ section.settings.heading }}
      </h1>
    {% endif %}
  </div>

  <!-- Comparison Table Card Container -->
  <div class="compare-container">
    <div class="compare-table-scroll">
      <table class="compare-table" role="table">
        <thead>
          <tr>
            <th class="col-label" scope="col"></th>
            <!-- Col 1: Paper -->
            <th class="col-item" scope="col">
              <div class="compare-head-item">
                <span class="compare-head-title">{{ section.settings.item1_name | default: 'PAPER' }}</span>
                <span class="compare-head-subtitle">{{ section.settings.item1_sub | default: 'WATER-ACTIVATED' }}</span>
              </div>
            </th>
            <!-- Col 2: Polypropylene -->
            <th class="col-item" scope="col">
              <div class="compare-head-item">
                <span class="compare-head-title">{{ section.settings.item2_name | default: 'POLYPROPYLENE' }}</span>
                <span class="compare-head-subtitle">{{ section.settings.item2_sub | default: 'PRESSURE-SENSITIVE' }}</span>
              </div>
            </th>
            <!-- Col 3: PVC -->
            <th class="col-item" scope="col">
              <div class="compare-head-item">
                <span class="compare-head-title">{{ section.settings.item3_name | default: 'PVC' }}</span>
                <span class="compare-head-subtitle">{{ section.settings.item3_sub | default: 'PRESSURE-SENSITIVE' }}</span>
              </div>
            </th>
            <!-- Col 4: Hi-Tack Freezer -->
            <th class="col-item" scope="col">
              <div class="compare-head-item">
                <span class="compare-head-title">{{ section.settings.item4_name | default: 'HI-TACK FREEZER' }}</span>
                <span class="compare-head-subtitle">{{ section.settings.item4_sub | default: 'HI-TACK COATED' }}</span>
              </div>
            </th>
            <!-- Col 5: Flatback -->
            <th class="col-item" scope="col">
              <div class="compare-head-item">
                <span class="compare-head-title">{{ section.settings.item5_name | default: 'FLATBACK' }}</span>
                <span class="compare-head-subtitle">{{ section.settings.item5_sub | default: 'NON-STRETCH' }}</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <!-- Category 1: MATERIAL -->
          <tr class="compare-cat-row">
            <td colspan="6">MATERIAL</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">FINISH</td>
            <td class="cell-data">Matte</td>
            <td class="cell-data">Glossy</td>
            <td class="cell-data">Semi-glossy</td>
            <td class="cell-data">Glossy</td>
            <td class="cell-data">Matte</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">ADHESIVE</td>
            <td class="cell-data">Water-activated</td>
            <td class="cell-data">Hot melt</td>
            <td class="cell-data">Natural rubber</td>
            <td class="cell-data">High-tack acrylic</td>
            <td class="cell-data">Rubber-based</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">COLOURS</td>
            <td class="cell-data">White, tan</td>
            <td class="cell-data">White, clear, tan, red, yellow</td>
            <td class="cell-data">White, clear, tan</td>
            <td class="cell-data">White, clear</td>
            <td class="cell-data">Tan, white</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">WIDTHS AND LENGTHS</td>
            <td class="cell-data">2 or 3 inch &times; 375, 450, 500 feet</td>
            <td class="cell-data">2 or 3 inch &times; 375, 450, 500 feet</td>
            <td class="cell-data">2 or 3 inch &times; 375, 450, 500 feet</td>
            <td class="cell-data">2 or 3 inch &times; 375, 450, 500 feet</td>
            <td class="cell-data">2 or 3 inch &times; 375, 450, 500 feet</td>
          </tr>

          <!-- Category 2: STRENGTH -->
          <tr class="compare-cat-row">
            <td colspan="6">STRENGTH</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">SEALS UP TO</td>
            <td class="cell-data">240 grade (30 lbs) &middot; 260 HD (30+ lbs)</td>
            <td class="cell-data">1.9 mil (30 lbs) &middot; 2.5 mil (50 lbs) &middot; 2.6 mil (50+ lbs)</td>
            <td class="cell-data">50+ lbs, heaviest loads</td>
            <td class="cell-data">Cold-chain loads</td>
            <td class="cell-data">Bundling only, not for sealing</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">STICKS TO</td>
            <td class="cell-data">Cardboard</td>
            <td class="cell-data">Cardboard</td>
            <td class="cell-data">Cardboard, plastic, glass, metal</td>
            <td class="cell-data">Cardboard, damp or frosted</td>
            <td class="cell-data">Paper and board</td>
          </tr>

          <!-- Category 3: TEMPERATURE -->
          <tr class="compare-cat-row">
            <td colspan="6">TEMPERATURE</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">IN SERVICE</td>
            <td class="cell-data">Room temp</td>
            <td class="cell-data">30&ndash;140&deg;F</td>
            <td class="cell-data">20&ndash;140&deg;F</td>
            <td class="cell-data">&ndash;20&ndash;140&deg;F</td>
            <td class="cell-data">Room temp</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">TO APPLY</td>
            <td class="cell-data">Above freezing</td>
            <td class="cell-data">54&ndash;110&deg;F</td>
            <td class="cell-data">Not published</td>
            <td class="cell-data">Any</td>
            <td class="cell-data">Room temp</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">BELOW FREEZING</td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--yes">YES</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
          </tr>

          <!-- Category 4: APPLYING IT -->
          <tr class="compare-cat-row">
            <td colspan="6">APPLYING IT</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">APPLICATION</td>
            <td class="cell-data">Water dispenser</td>
            <td class="cell-data">Tape gun or machine</td>
            <td class="cell-data">Tape gun</td>
            <td class="cell-data">Tape gun</td>
            <td class="cell-data">Tears by hand</td>
          </tr>

          <!-- Category 5: PRINTING -->
          <tr class="compare-cat-row">
            <td colspan="6">PRINTING</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">PRINT DETAIL</td>
            <td class="cell-data">Sharp</td>
            <td class="cell-data">Sharp</td>
            <td class="cell-data">Limited detail</td>
            <td class="cell-data">Standard</td>
            <td class="cell-data">Sharp, matte</td>
          </tr>

          <!-- Category 6: DISPOSAL -->
          <tr class="compare-cat-row">
            <td colspan="6">DISPOSAL</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">TAMPER EVIDENT</td>
            <td class="cell-data"><span class="compare-pill compare-pill--yes">YES</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">RECYCLABLE</td>
            <td class="cell-data"><span class="compare-pill compare-pill--yes">YES</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--no">NO</span></td>
            <td class="cell-data"><span class="compare-pill compare-pill--yes">YES</span></td>
          </tr>

          <!-- Category 7: PRICE -->
          <tr class="compare-cat-row">
            <td colspan="6">PRICE</td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">FROM, A ROLL</td>
            <!-- Paper -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item1_price | default: '$9.10' }}</div>
              <div class="compare-price-sub">{{ section.settings.item1_price_sub | default: 'AT 64 CASES' }}</div>
            </td>
            <!-- Polypropylene -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item2_price | default: '$5.68' }}</div>
              <div class="compare-price-sub">{{ section.settings.item2_price_sub | default: 'AT 64 CASES' }}</div>
            </td>
            <!-- PVC -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item3_price | default: '$7.84' }}</div>
              <div class="compare-price-sub">{{ section.settings.item3_price_sub | default: 'AT 64 CASES' }}</div>
            </td>
            <!-- Hi-Tack Freezer -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item4_price | default: '$10.18' }}</div>
              <div class="compare-price-sub">{{ section.settings.item4_price_sub | default: 'AT 64 CASES' }}</div>
            </td>
            <!-- Flatback -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item5_price | default: '$7.12' }}</div>
              <div class="compare-price-sub">{{ section.settings.item5_price_sub | default: 'AT 64 CASES' }}</div>
            </td>
          </tr>
          <tr class="compare-data-row">
            <td class="cell-label">MINIMUM ORDER</td>
            <!-- Paper -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item1_min | default: '$718.75' }}</div>
              <div class="compare-price-sub">{{ section.settings.item1_min_sub | default: '40 ROLLS' }}</div>
            </td>
            <!-- Polypropylene -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item2_min | default: '$464.63' }}</div>
              <div class="compare-price-sub">{{ section.settings.item2_min_sub | default: '40 ROLLS' }}</div>
            </td>
            <!-- PVC -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item3_min | default: '$625.13' }}</div>
              <div class="compare-price-sub">{{ section.settings.item3_min_sub | default: '40 ROLLS' }}</div>
            </td>
            <!-- Hi-Tack Freezer -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item4_min | default: '$799.00' }}</div>
              <div class="compare-price-sub">{{ section.settings.item4_min_sub | default: '40 ROLLS' }}</div>
            </td>
            <!-- Flatback -->
            <td class="cell-data">
              <div class="compare-price-val">{{ section.settings.item5_min | default: '$571.63' }}</div>
              <div class="compare-price-sub">{{ section.settings.item5_min_sub | default: '40 ROLLS' }}</div>
            </td>
          </tr>

          <!-- Footer / CTA Row -->
          <tr class="compare-footer-row">
            <td class="cell-label"></td>
            <td class="cell-data">
              <a href="{{ section.settings.item1_url | default: '/collections' }}" class="compare-see-link">
                SEE THE PAGE <span class="arr">&rarr;</span>
              </a>
            </td>
            <td class="cell-data">
              <a href="{{ section.settings.item2_url | default: '/collections' }}" class="compare-see-link">
                SEE THE PAGE <span class="arr">&rarr;</span>
              </a>
            </td>
            <td class="cell-data">
              <a href="{{ section.settings.item3_url | default: '/collections' }}" class="compare-see-link">
                SEE THE PAGE <span class="arr">&rarr;</span>
              </a>
            </td>
            <td class="cell-data">
              <a href="{{ section.settings.item4_url | default: '/collections' }}" class="compare-see-link">
                SEE THE PAGE <span class="arr">&rarr;</span>
              </a>
            </td>
            <td class="cell-data">
              <a href="{{ section.settings.item5_url | default: '/collections' }}" class="compare-see-link">
                SEE THE PAGE <span class="arr">&rarr;</span>
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

