      "label": "Heading",
      "default": "The whole ladder, nothing hidden."
    },
    {
      "type": "header",
      "content": "Column Headers"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Column 1 Label",
      "default": "CASES"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Column 2 Label",
      "default": "ROLLS"
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Column 3 Label",
      "default": "PER CASE"
    },
    {
      "type": "text",
      "id": "col_4_label",
      "label": "Column 4 Label",
