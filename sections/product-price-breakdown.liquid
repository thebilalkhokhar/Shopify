          "label": "Cases",
          "default": "5"
        },
        {
          "type": "text",
          "id": "rolls",
          "label": "Rolls",
          "default": "40"
        },
        {
          "type": "text",
          "id": "per_case",
          "label": "Per Case",
          "default": "$82.93"
        },
        {
          "type": "text",
          "id": "tape",
          "label": "Tape",
          "default": "$414.63"
        },
        {
          "type": "text",
          "id": "total",
          "label": "Total",
          "default": "$464.63"
        },
        {
          "type": "text",
          "id": "per_roll",
          "label": "Per Roll",
          "default": "$11.62"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Price Breakdown",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "cases": "5",
            "rolls": "40",
            "per_case": "$82.93",
            "tape": "$414.63",
            "total": "$464.63",
            "per_roll": "$11.62"
          }
        },
        {
          "type": "row",
          "settings": {
            "cases": "10",
            "rolls": "80",
            "per_case": "$71.72",
            "tape": "$717.22",
            "total": "$767.22",
            "per_roll": "$9.59"
          }
        },
        {
          "type": "row",
          "settings": {
            "cases": "25",
            "rolls": "200",
            "per_case": "$57.06",
            "tape": "$1476.62",
            "total": "$1476.62",
            "per_roll": "$7.38"
          }
        },
        {
          "type": "row",
          "settings": {
            "cases": "50",
            "rolls": "400",
            "per_case": "$51.07",
            "tape": "$2,553.47",
            "total": "$2,603.47",
            "per_roll": "$6.51"
          }
        },
        {
          "type": "row",
          "settings": {
            "cases": "64",
            "rolls": "512",
            "per_case": "$44.66",
            "tape": "$2,858.55",
            "total": "$2,908.55",
            "per_roll": "$5.68"
          }
        }
      ]
    }
  ]
}
{% endschema %}
