{{ 'product-price-breakdown.css' | asset_url | stylesheet_tag }}

<section
  id="product-price-breakdown-{{ section.id }}"
  class="product-price-breakdown-section"
  style="
    background-color: {{ section.settings.bg_color | default: '#FBF8F3' }};
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="ppb-container">
    
    <!-- Header: Badge & Main Title -->
    <div class="ppb-header">
      {%- if section.settings.badge_text != blank -%}
        <div class="ppb-badge-wrap">
          <span class="ppb-badge">{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ppb-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <!-- Table Card Box -->
    <div class="ppb-table-card">
      <div class="ppb-table-responsive">
        <table class="ppb-table">
          <thead>
            <tr>
              <th class="ppb-col-cases">{{ section.settings.col_1_label | default: 'CASES' }}</th>
              <th class="ppb-col-rolls">{{ section.settings.col_2_label | default: 'ROLLS' }}</th>
              <th class="ppb-col-percase">{{ section.settings.col_3_label | default: 'PER CASE' }}</th>
              <th class="ppb-col-tape">{{ section.settings.col_4_label | default: 'TAPE' }}</th>
              <th class="ppb-col-total">{{ section.settings.col_5_label | default: 'TOTAL' }}</th>
              <th class="ppb-col-perroll">{{ section.settings.col_6_label | default: 'PER ROLL' }}</th>
            </tr>
          </thead>
          <tbody>
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="ppb-col-cases">{{ block.settings.cases }}</td>
                  <td class="ppb-col-rolls">{{ block.settings.rolls }}</td>
                  <td class="ppb-col-percase">{{ block.settings.per_case }}</td>
                  <td class="ppb-col-tape">{{ block.settings.tape }}</td>
                  <td class="ppb-col-total">{{ block.settings.total }}</td>
                  <td class="ppb-col-perroll">{{ block.settings.per_roll }}</td>
                </tr>
              {%- endfor -%}
            {%- else -%}
              <!-- Default Rows Matching Exact Reference Image -->
              <tr>
                <td class="ppb-col-cases">5</td>
                <td class="ppb-col-rolls">40</td>
                <td class="ppb-col-percase">$82.93</td>
                <td class="ppb-col-tape">$414.63</td>
                <td class="ppb-col-total">$464.63</td>
                <td class="ppb-col-perroll">$11.62</td>
              </tr>
              <tr>
                <td class="ppb-col-cases">10</td>
                <td class="ppb-col-rolls">80</td>
                <td class="ppb-col-percase">$71.72</td>
                <td class="ppb-col-tape">$717.22</td>
                <td class="ppb-col-total">$767.22</td>
                <td class="ppb-col-perroll">$9.59</td>
              </tr>
              <tr>
                <td class="ppb-col-cases">25</td>
                <td class="ppb-col-rolls">200</td>
                <td class="ppb-col-percase">$57.06</td>
                <td class="ppb-col-tape">$1476.62</td>
                <td class="ppb-col-total">$1476.62</td>
                <td class="ppb-col-perroll">$7.38</td>
              </tr>
              <tr>
                <td class="ppb-col-cases">50</td>
                <td class="ppb-col-rolls">400</td>
                <td class="ppb-col-percase">$51.07</td>
                <td class="ppb-col-tape">$2,553.47</td>
                <td class="ppb-col-total">$2,603.47</td>
                <td class="ppb-col-perroll">$6.51</td>
              </tr>
              <tr>
                <td class="ppb-col-cases">64</td>
                <td class="ppb-col-rolls">512</td>
                <td class="ppb-col-percase">$44.66</td>
                <td class="ppb-col-tape">$2,858.55</td>
                <td class="ppb-col-total">$2,908.55</td>
                <td class="ppb-col-perroll">$5.68</td>
              </tr>
            {%- endif -%}
          </tbody>
        </table>
      </div>
    </div>

    <div class="ppb-mobile-cards">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="ppb-mobile-card">
            <div class="ppb-mobile-card-header">
              <h3 class="ppb-mobile-card-title">
                <span>{{ block.settings.cases | escape }}</span>
                <span>{{ section.settings.col_1_label | default: 'CASES' | downcase | escape }}</span>
              </h3>
              <p class="ppb-mobile-card-rolls">
                <span>{{ block.settings.rolls | escape }}</span>
                <span>{{ section.settings.col_2_label | default: 'ROLLS' | downcase | escape }}</span>
              </p>
            </div>

            <dl class="ppb-mobile-details">
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_3_label | default: 'PER CASE' | escape }}</dt>
                <dd>{{ block.settings.per_case | escape }}</dd>
              </div>
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_4_label | default: 'TAPE' | escape }}</dt>
                <dd>{{ block.settings.tape | escape }}</dd>
              </div>
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_5_label | default: 'TOTAL' | escape }}</dt>
                <dd>{{ block.settings.total | escape }}</dd>
              </div>
              <div class="ppb-mobile-detail ppb-mobile-detail--per-roll">
                <dt>{{ section.settings.col_6_label | default: 'PER ROLL' | escape }}</dt>
                <dd>{{ block.settings.per_roll | escape }}</dd>
              </div>
            </dl>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_cases = '5,10,25,50,64' | split: ',' -%}
        {%- for case_count in fallback_cases -%}
          {%- case case_count -%}
            {%- when '5' -%}
              {%- assign row_rolls = '40' -%}
              {%- assign row_per_case = '$82.93' -%}
              {%- assign row_tape = '$414.63' -%}
              {%- assign row_total = '$464.63' -%}
              {%- assign row_per_roll = '$11.62' -%}
            {%- when '10' -%}
              {%- assign row_rolls = '80' -%}
              {%- assign row_per_case = '$71.72' -%}
              {%- assign row_tape = '$717.22' -%}
              {%- assign row_total = '$767.22' -%}
              {%- assign row_per_roll = '$9.59' -%}
            {%- when '25' -%}
              {%- assign row_rolls = '200' -%}
              {%- assign row_per_case = '$57.06' -%}
              {%- assign row_tape = '$1476.62' -%}
              {%- assign row_total = '$1476.62' -%}
              {%- assign row_per_roll = '$7.38' -%}
            {%- when '50' -%}
              {%- assign row_rolls = '400' -%}
              {%- assign row_per_case = '$51.07' -%}
              {%- assign row_tape = '$2,553.47' -%}
              {%- assign row_total = '$2,603.47' -%}
              {%- assign row_per_roll = '$6.51' -%}
            {%- when '64' -%}
              {%- assign row_rolls = '512' -%}
              {%- assign row_per_case = '$44.66' -%}
              {%- assign row_tape = '$2,858.55' -%}
              {%- assign row_total = '$2,908.55' -%}
              {%- assign row_per_roll = '$5.68' -%}
          {%- endcase -%}
          <article class="ppb-mobile-card">
            <div class="ppb-mobile-card-header">
              <h3 class="ppb-mobile-card-title">
                <span>{{ case_count }}</span>
                <span>{{ section.settings.col_1_label | default: 'CASES' | downcase | escape }}</span>
              </h3>
              <p class="ppb-mobile-card-rolls">
                <span>{{ row_rolls }}</span>
                <span>{{ section.settings.col_2_label | default: 'ROLLS' | downcase | escape }}</span>
              </p>
            </div>

            <dl class="ppb-mobile-details">
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_3_label | default: 'PER CASE' | escape }}</dt>
                <dd>{{ row_per_case }}</dd>
              </div>
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_4_label | default: 'TAPE' | escape }}</dt>
                <dd>{{ row_tape }}</dd>
              </div>
              <div class="ppb-mobile-detail">
                <dt>{{ section.settings.col_5_label | default: 'TOTAL' | escape }}</dt>
                <dd>{{ row_total }}</dd>
              </div>
              <div class="ppb-mobile-detail ppb-mobile-detail--per-roll">
                <dt>{{ section.settings.col_6_label | default: 'PER ROLL' | escape }}</dt>
                <dd>{{ row_per_roll }}</dd>
              </div>
            </dl>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
