{{ 'contact-form.css' | asset_url | stylesheet_tag }}

<section
  id="contact-form-{{ section.id }}"
  class="contact-form-section"
  style="
    --cf-page-bg: {{ section.settings.page_bg | default: '#171008' }};
    --cf-card-bg: {{ section.settings.card_bg | default: '#F9F6F0' }};
    --cf-dot: {{ section.settings.dot_color | default: 'rgba(0, 0, 0, 0.12)' }};
  "
  {{ section.shopify_attributes }}
>
  <div class="contact-form-outer-wrap">
    <div class="contact-form-card-frame">
      <div class="contact-form-grid">
        <!-- ================= LEFT COLUMN ================= -->
        <div class="contact-left-col">
          <div class="contact-header-text">
            <h1 class="contact-main-heading">{{ section.settings.heading | default: 'How can we help?' }}</h1>
            <p class="contact-main-subtext">
              {{
                section.settings.subheading
                | default: "Whether you're exploring Tape Fox packaging for your business or need help with a new or existing order, we're here to answer all your questions."
              }}
            </p>
          </div>

          <!-- 2 Support Cards (Email & Chat) -->
          <div class="contact-info-cards-row">
            <!-- Card 1: Email -->
            <div class="contact-info-card">
              <span class="contact-card-label">{{ section.settings.card_email_label | default: 'Email' }}</span>
              <a
                href="mailto:{{ section.settings.card_email_val | default: 'hello@tapefox.com' }}"
                class="contact-card-val"
              >
                {{ section.settings.card_email_val | default: 'hello@tapefox.com' }}
              </a>
              <span class="contact-card-note">
                {{- section.settings.card_email_note | default: 'One working day, usually less' -}}
              </span>
            </div>

            <!-- Card 2: Chat with us -->
            <div class="contact-info-card">
              <span class="contact-card-label">{{ section.settings.card_chat_label | default: 'Chat with us' }}</span>
              <div class="contact-card-actions">
                <a href="{{ section.settings.call_url | default: 'tel:+18005550199' }}" class="contact-action-link">
                  {{ section.settings.call_label | default: 'Call us' }}
                </a>
                <span class="contact-action-sep">or</span>
                <a
                  href="{{ section.settings.whatsapp_url | default: 'https://wa.me/18005550199' }}"
                  class="contact-action-link contact-wa-link"
                  target="_blank"
                  rel="noopener"
                >
                  {% if section.settings.whatsapp_icon != blank %}
                    <img
                      src="{{ section.settings.whatsapp_icon | image_url: width: 48 }}"
                      alt="{{ section.settings.whatsapp_icon.alt | default: section.settings.whatsapp_label | default: 'WhatsApp' }}"
                      class="contact-wa-custom-icon"
                      width="18"
                      height="18"
                      loading="lazy"
                    >
                  {% else %}
                    <svg
                      class="contact-wa-icon"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  {% endif %}
                  {{ section.settings.whatsapp_label | default: 'Whatsapp' }}
                </a>
              </div>
              <span class="contact-card-note">
                {{- section.settings.card_chat_note | default: 'Fastest for anything already on the press' -}}
              </span>
            </div>
          </div>

          <!-- 2 Status Pills (Hours & Weekends) -->
          <div class="contact-status-pills-row">
            <div class="contact-status-pill">
              <span class="contact-status-dot contact-status-dot--green"></span>
              <span class="contact-status-text">
                {{- section.settings.status_open_text | default: 'Mon–Fri, 8am–6pm ET' -}}
              </span>
            </div>
            <div class="contact-status-pill">
              <span class="contact-status-dot contact-status-dot--red"></span>
              <span class="contact-status-text">
                {{- section.settings.status_closed_text | default: 'Closed weekends' -}}
              </span>
            </div>
          </div>

          <!-- Fox Mascot with Thought/Speech Bubble -->
          <div class="contact-mascot-wrapper">
            <div class="contact-mascot-image-box">
              {% if section.settings.mascot_image != blank %}
                <img
                  src="{{ section.settings.mascot_image | image_url: width: 600 }}"
                  alt="{{ section.settings.mascot_image.alt | default: 'TapeFox Mascot' }}"
                  class="contact-mascot-img"
                  width="{{ section.settings.mascot_width | default: 240 }}"
                  height="auto"
                  loading="eager"
                >
              {% else %}
                <img
                  src="{{ 'innerRingLogo.webp' | asset_img_url: '600x' }}"
                  alt="TapeFox Mascot"
                  class="contact-mascot-img"
                  width="240"
                  height="auto"
                  loading="eager"
                  onerror="this.style.display='none'"
                >
              {% endif %}
            </div>
          </div>
        </div>

        <!-- ================= RIGHT COLUMN ================= -->
        <div class="contact-right-col">
          <!-- Lane Selection Header ("Pick a lane" pill + "Let's talk.") -->
          <div class="contact-lane-header">
            <div class="contact-lane-badge-wrap">
              <span class="contact-lane-badge">{{ section.settings.lane_badge_text | default: 'Pick a lane' }}</span>
            </div>
            <h2 class="contact-lane-heading">{{ section.settings.lane_heading | default: "Let's talk." }}</h2>
          </div>

          <!-- 3 Lane Cards (New Order, Existing Order, General Support) -->
          <div class="contact-lane-cards" role="radiogroup" aria-label="Topic selection">
            <!-- Lane 1: New Order (Active by default via checked radio) -->
            <label class="contact-lane-card">
              <input type="radio" name="contact_lane" value="New Order" class="contact-lane-radio" checked>
              <div class="contact-lane-card-inner">
                <div class="contact-lane-title">{{ section.settings.lane1_title | default: 'New Order' }}</div>
                <div class="contact-lane-desc">
                  {{
                    section.settings.lane1_desc
                    | default: 'Pricing, an odd width, pallet quantities, or you want to know what your logo will look like on the roll'
                  }}
                </div>
              </div>
            </label>

            <!-- Lane 2: An Existing order -->
            <label class="contact-lane-card">
              <input type="radio" name="contact_lane" value="Existing Order" class="contact-lane-radio">
              <div class="contact-lane-card-inner">
                <div class="contact-lane-title">{{ section.settings.lane2_title | default: 'An Existing order' }}</div>
                <div class="contact-lane-desc">
                  {{
                    section.settings.lane2_desc
                    | default: 'A proof that us not right, a delivery that went wrong, damaged rolls, or a reorder on the same plate'
                  }}
                </div>
              </div>
            </label>

            <!-- Lane 3: General Support -->
            <label class="contact-lane-card">
              <input type="radio" name="contact_lane" value="General Support" class="contact-lane-radio">
              <div class="contact-lane-card-inner">
                <div class="contact-lane-title">{{ section.settings.lane3_title | default: 'General Support' }}</div>
                <div class="contact-lane-desc">
                  {{
                    section.settings.lane3_desc
                    | default: 'Artwork advice, dispensers, how any of this works, press enquiries, or a job application.'
                  }}
                </div>
              </div>
            </label>
          </div>

          <!-- Main Form Container Box -->
          <div class="contact-form-card" id="ContactFormCard">
            <div class="contact-form-card-header">
              <h3 class="contact-form-subheading" id="ContactFormHeading">
                {{ section.settings.form_heading | default: 'What are you looking to print?' }}
              </h3>
              <span class="contact-form-badge">
                {{- section.settings.form_badge_text | default: 'Same day, most days' -}}
              </span>
            </div>

            {% form 'contact', id: 'ContactForm', class: 'contact-form-element' %}
              {% if form.posted_successfully? %}
                <div class="contact-form-feedback contact-form-feedback--success" tabindex="-1" autofocus>
                  <span>Thank you! Your message has been sent. We'll be in touch shortly.</span>
                </div>
              {% elsif form.errors %}
                <div class="contact-form-feedback contact-form-feedback--error" tabindex="-1" autofocus>
                  <span>Please correct the errors and try again.</span>
                </div>
              {% endif %}

              <!-- Hidden Lane Tracker -->
              <input type="hidden" name="contact[lane]" id="ContactFormLaneInput" value="New Order">

              <!-- ================= EXISTING ORDER ONLY: WHAT'S HAPPENED TABS ================= -->
              <div class="contact-form-happened-wrap" id="ContactHappenedWrap" style="display: none;">
                <label class="contact-form-label">WHAT'S HAPPENED?</label>
                <div class="contact-happened-pills" role="radiogroup" aria-label="Issue type">
                  <label class="contact-happened-pill">
                    <input type="radio" name="contact[whats_happened]" value="Proof is not right" class="contact-happened-radio" checked>
                    <span class="contact-happened-btn">Proof is not right</span>
                  </label>
                  <label class="contact-happened-pill">
                    <input type="radio" name="contact[whats_happened]" value="Delivery went wrong" class="contact-happened-radio">
                    <span class="contact-happened-btn">Delivery went wrong</span>
                  </label>
                  <label class="contact-happened-pill">
                    <input type="radio" name="contact[whats_happened]" value="Damaged rolls" class="contact-happened-radio">
                    <span class="contact-happened-btn">Damaged rolls</span>
                  </label>
                  <label class="contact-happened-pill">
                    <input type="radio" name="contact[whats_happened]" value="Reorder, same plate" class="contact-happened-radio">
                    <span class="contact-happened-btn">Reorder, same plate</span>
                  </label>
                  <label class="contact-happened-pill">
                    <input type="radio" name="contact[whats_happened]" value="Something else" class="contact-happened-radio">
                    <span class="contact-happened-btn">Something else</span>
                  </label>
                </div>
              </div>

              <!-- ================= FIELDS SET A: DEFAULT (New Order / General Support) ================= -->
              <div class="contact-fields-group" id="ContactDefaultFields">
                <!-- Row 1: Name & Company -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormName" class="contact-form-label">YOUR NAME</label>
                    <input
                      type="text"
                      id="ContactFormName"
                      name="contact[name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      class="contact-form-input"
                      autocomplete="name"
                      required
                    >
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormCompany" class="contact-form-label">COMPANY</label>
                    <input
                      type="text"
                      id="ContactFormCompany"
                      name="contact[company]"
                      class="contact-form-input"
                      autocomplete="organization"
                    >
                  </div>
                </div>

                <!-- Row 2: Email & Material -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormEmail" class="contact-form-label">EMAIL</label>
                    <input
                      type="email"
                      id="ContactFormEmail"
                      name="contact[email]"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      class="contact-form-input"
                      spellcheck="false"
                      autocomplete="email"
                      autocapitalize="off"
                      required
                    >
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormMaterial" class="contact-form-label">MATERIAL</label>
                    <div class="contact-select-wrap">
                      <select id="ContactFormMaterial" name="contact[material]" class="contact-form-select">
                        <option value="Not Sure yet?" selected>Not Sure yet?</option>
                        <option value="Paper Tape (Water-Activated)">Paper Tape (Water-Activated)</option>
                        <option value="Polypropylene Tape">Polypropylene Tape</option>
                        <option value="PVC Tape">PVC Tape</option>
                        <option value="Hi-Tack Freezer Tape">Hi-Tack Freezer Tape</option>
                        <option value="Flatback Tape">Flatback Tape</option>
                        <option value="Dispensers">Dispensers</option>
                      </select>
                      <svg
                        class="contact-select-arrow"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </div>
                  </div>
                </div>

                <!-- Row 3: Quantity (Half Width) -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormQuantity" class="contact-form-label"
                      >WHAT QUANTITY ARE YOU SHOPPING FOR?</label
                    >
                    <input
                      type="text"
                      id="ContactFormQuantity"
                      name="contact[quantity]"
                      placeholder="Cases, rolls, or 'no idea yet'"
                      class="contact-form-input"
                    >
                  </div>
                </div>
              </div>

              <!-- ================= FIELDS SET C: GENERAL SUPPORT ================= -->
              <div class="contact-fields-group" id="ContactGeneralFields" style="display: none;">
                <!-- Row 1: Name & Company -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormGeneralName" class="contact-form-label">YOUR NAME</label>
                    <input
                      type="text"
                      id="ContactFormGeneralName"
                      name="contact[general_name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      class="contact-form-input"
                      autocomplete="name"
                    >
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormGeneralCompany" class="contact-form-label">COMPANY</label>
                    <input
                      type="text"
                      id="ContactFormGeneralCompany"
                      name="contact[general_company]"
                      class="contact-form-input"
                      autocomplete="organization"
                    >
                  </div>
                </div>

                <!-- Row 2: Email (Full Width) -->
                <div class="contact-form-row" style="margin-bottom: 20px;">
                  <div class="contact-form-group">
                    <label for="ContactFormGeneralEmail" class="contact-form-label">EMAIL</label>
                    <input
                      type="email"
                      id="ContactFormGeneralEmail"
                      name="contact[general_email]"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      class="contact-form-input"
                      spellcheck="false"
                      autocomplete="email"
                      autocapitalize="off"
                    >
                  </div>
                </div>
              </div>

              <!-- ================= FIELDS SET B: EXISTING ORDER ================= -->
              <div class="contact-fields-group" id="ContactExistingFields" style="display: none;">
                <!-- Row 1: Order Number & Email on the order -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormOrderNumber" class="contact-form-label">ORDER NUMBER</label>
                    <input
                      type="text"
                      id="ContactFormOrderNumber"
                      name="contact[order_number]"
                      class="contact-form-input"
                    >
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormOrderEmail" class="contact-form-label">EMAIL ON THE ORDER</label>
                    <input
                      type="email"
                      id="ContactFormOrderEmail"
                      name="contact[order_email]"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      class="contact-form-input"
                      spellcheck="false"
                      autocomplete="email"
                      autocapitalize="off"
                    >
                  </div>
                </div>

                <!-- Row 2: Your Name & Company -->
                <div class="contact-form-row contact-form-row--two-col">
                  <div class="contact-form-group">
                    <label for="ContactFormExistingName" class="contact-form-label">YOUR NAME</label>
                    <input
                      type="text"
                      id="ContactFormExistingName"
                      name="contact[existing_name]"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      class="contact-form-input"
                      autocomplete="name"
                    >
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormExistingCompany" class="contact-form-label">COMPANY</label>
                    <input
                      type="text"
                      id="ContactFormExistingCompany"
                      name="contact[existing_company]"
                      class="contact-form-input"
                      autocomplete="organization"
                    >
                  </div>
                </div>

                <!-- Row 3 (Conditional for Delivery went wrong / Damaged rolls): 3 Columns -->
                <div class="contact-form-row contact-form-row--three-col" id="ContactAffectedRow" style="display: none;">
                  <div class="contact-form-group">
                    <label for="ContactFormRolls" class="contact-form-label">ROLLS AFFECTED</label>
                    <div class="contact-select-wrap">
                      <select id="ContactFormRolls" name="contact[rolls_affected]" class="contact-form-select">
                        <option value="0" selected>0</option>
                        <option value="1-5">1-5</option>
                        <option value="6-20">6-20</option>
                        <option value="21-50">21-50</option>
                        <option value="50+">50+</option>
                        <option value="All">All</option>
                      </select>
                      <svg class="contact-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </div>
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormCases" class="contact-form-label">CASES AFFECTED</label>
                    <div class="contact-select-wrap">
                      <select id="ContactFormCases" name="contact[cases_affected]" class="contact-form-select">
                        <option value="0" selected>0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3-5">3-5</option>
                        <option value="6+">6+</option>
                        <option value="All">All</option>
                      </select>
                      <svg class="contact-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m6 9 6 6 6-6"/>
                      </svg>
                    </div>
                  </div>

                  <div class="contact-form-group">
                    <label for="ContactFormDateArrived" class="contact-form-label">DATE IT ARRIVED</label>
                    <input
                      type="text"
                      id="ContactFormDateArrived"
                      name="contact[date_arrived]"
                      placeholder="mm/dd/yyyy"
                      class="contact-form-input"
                    >
                  </div>
                </div>
              </div>

              <!-- Row 4: Artwork Box -->
              <div class="contact-form-row">
                <div class="contact-form-group">
                  <label class="contact-form-label">ARTWORK</label>
                  <div class="contact-artwork-upload-zone">
                    <input
                      type="file"
                      id="ContactFormFile"
                      name="contact[artwork_file]"
                      class="contact-artwork-file-input"
                    >
                    <label for="ContactFormFile" class="contact-artwork-inner-label">
                      <span class="contact-artwork-action-text">Choose a file</span>
                      <span class="contact-artwork-helper-text"
                        >PDF, AI or EPS. Up to 20 MB. No file? Leave it and describe it below.</span
                      >
                    </label>
                  </div>
                </div>
              </div>

              <!-- Row 5: Message -->
              <div class="contact-form-row">
                <div class="contact-form-group">
                  <label for="ContactFormMessage" class="contact-form-label">MESSAGE</label>
                  <textarea
                    rows="4"
                    id="ContactFormMessage"
                    name="contact[body]"
                    class="contact-form-textarea"
                  >{{ form.body }}</textarea>
                </div>
              </div>

              <!-- Row 6: Submit Button & Disclaimer Text -->
              <div class="contact-form-bottom-row">
                <button type="submit" class="contact-submit-btn">
                  <span>{{ section.settings.btn_text | default: 'Send it' }}</span>
                  <span class="contact-submit-arrow">→</span>
                </button>

                <div class="contact-submit-disclaimer">
                  {{
                    section.settings.disclaimer_text
                    | default: 'Comes from a real address you can reply to. No ticket numbers, no do-not-reply.'
                  }}
                </div>
              </div>
            {% endform %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initContactForm() {
      var section = document.getElementById('contact-form-{{ section.id }}');
      if (!section) return;

      var laneRadios = section.querySelectorAll('.contact-lane-radio');
      var happenedRadios = section.querySelectorAll('.contact-happened-radio');
      var headingEl = section.querySelector('#ContactFormHeading');
      var happenedWrap = section.querySelector('#ContactHappenedWrap');
      var defaultFields = section.querySelector('#ContactDefaultFields');
      var existingFields = section.querySelector('#ContactExistingFields');
      var affectedRow = section.querySelector('#ContactAffectedRow');
      var laneHiddenInput = section.querySelector('#ContactFormLaneInput');

      var defaultHeading = {{ section.settings.form_heading | default: 'What are you looking to print?' | json }};
      var existingHeading = {{ section.settings.existing_heading | default: "Let's find your job first." | json }};

      var generalFields = section.querySelector('#ContactGeneralFields');

      function updateFormState() {
        var selectedLane = 'New Order';
        laneRadios.forEach(function(radio) {
          if (radio.checked) selectedLane = radio.value;
        });

        if (laneHiddenInput) laneHiddenInput.value = selectedLane;

        // Reset all required flags first
        var nameDef = defaultFields ? defaultFields.querySelector('#ContactFormName') : null;
        var emailDef = defaultFields ? defaultFields.querySelector('#ContactFormEmail') : null;
        var nameExist = existingFields ? existingFields.querySelector('#ContactFormExistingName') : null;
        var emailExist = existingFields ? existingFields.querySelector('#ContactFormOrderEmail') : null;
        var nameGen = generalFields ? generalFields.querySelector('#ContactFormGeneralName') : null;
        var emailGen = generalFields ? generalFields.querySelector('#ContactFormGeneralEmail') : null;

        if (nameDef) nameDef.required = false;
        if (emailDef) emailDef.required = false;
        if (nameExist) nameExist.required = false;
        if (emailExist) emailExist.required = false;
        if (nameGen) nameGen.required = false;
        if (emailGen) emailGen.required = false;

        if (selectedLane === 'Existing Order') {
          if (headingEl) headingEl.textContent = existingHeading;
          if (happenedWrap) happenedWrap.style.display = 'block';
          if (defaultFields) defaultFields.style.display = 'none';
          if (generalFields) generalFields.style.display = 'none';
          if (existingFields) existingFields.style.display = 'block';

          if (nameExist) nameExist.required = true;
          if (emailExist) emailExist.required = true;

          // Check which happened pill is selected
          var selectedHappened = 'Proof is not right';
          happenedRadios.forEach(function(hRadio) {
            if (hRadio.checked) selectedHappened = hRadio.value;
          });

          // If "Delivery went wrong" or "Damaged rolls", show 3-column row (Rolls, Cases, Date)
          if (selectedHappened === 'Delivery went wrong' || selectedHappened === 'Damaged rolls') {
            if (affectedRow) affectedRow.style.display = 'grid';
          } else {
            if (affectedRow) affectedRow.style.display = 'none';
          }
        } else if (selectedLane === 'General Support') {
          // General Support: Name & Company (two-col), Email (full width), Artwork, Message
          if (headingEl) headingEl.textContent = defaultHeading;
          if (happenedWrap) happenedWrap.style.display = 'none';
          if (defaultFields) defaultFields.style.display = 'none';
          if (existingFields) existingFields.style.display = 'none';
          if (affectedRow) affectedRow.style.display = 'none';
          if (generalFields) generalFields.style.display = 'block';

          if (nameGen) nameGen.required = true;
          if (emailGen) emailGen.required = true;
        } else {
          // New Order: Name & Company (two-col), Email & Material (two-col), Quantity (half), Artwork, Message
          if (headingEl) headingEl.textContent = defaultHeading;
          if (happenedWrap) happenedWrap.style.display = 'none';
          if (existingFields) existingFields.style.display = 'none';
          if (generalFields) generalFields.style.display = 'none';
          if (affectedRow) affectedRow.style.display = 'none';
          if (defaultFields) defaultFields.style.display = 'block';

          if (nameDef) nameDef.required = true;
          if (emailDef) emailDef.required = true;
        }
      }

      laneRadios.forEach(function(radio) {
        radio.addEventListener('change', updateFormState);
      });

      happenedRadios.forEach(function(radio) {
        radio.addEventListener('change', updateFormState);
      });

      updateFormState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.id === 'contact-form-{{ section.id }}' || e.target.querySelector('#contact-form-{{ section.id }}')) {
        initContactForm();
      }
    });
  })();
</script>

