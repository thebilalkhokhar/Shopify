{{ 'faqs-footer-support.css' | asset_url | stylesheet_tag }}

<section
  id="faqs-footer-support-{{ section.id }}"
  class="faqs-footer-support-section"
  style="
    --ffs-card-bg: {{ section.settings.card_bg | default: '#EA5B1B' }};
    --ffs-mascot-w: {{ section.settings.mascot_width | default: 220 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="ffs-card">
    <!-- Combined Left Group: Text + Fox right next to it -->
    <div class="ffs-left-group">
      <div class="ffs-text-col">
        {% if section.settings.badge_text != blank %}
          <div class="ffs-badge">{{ section.settings.badge_text }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ffs-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="ffs-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <!-- Fox Mascot: Text k bilkul sath aage -->
      <div class="ffs-mascot-col">
        {% if section.settings.mascot_image != blank %}
          <img
            src="{{ section.settings.mascot_image | image_url: width: 600 }}"
            alt="{{ section.settings.mascot_image.alt | default: 'TapeFox Mascot' }}"
            class="ffs-mascot-img"
            width="{{ section.settings.mascot_width | default: 220 }}"
            height="auto"
            loading="lazy"
          >
        {% elsif request.design_mode %}
          <div class="ffs-slot-hint">🦊 Upload Mascot Image</div>
        {% endif %}
      </div>
    </div>

    <!-- Right Support Cards: Email & Chat -->
    <div class="ffs-contact-cards-wrap">
      <!-- Card 1: Email -->
      <div class="ffs-contact-card ffs-email-card">
        <span class="ffs-card-label">{{ section.settings.card_1_label | default: 'Email' }}</span>
        <a href="mailto:{{ section.settings.card_1_email | default: 'hello@tapefox.com' }}" class="ffs-card-value">
          {{ section.settings.card_1_email | default: 'hello@tapefox.com' }}
        </a>
        <span class="ffs-card-note">{{ section.settings.card_1_note | default: 'One working day, usually less' }}</span>
      </div>

      <!-- Card 2: Chat with us -->
      <div class="ffs-contact-card ffs-chat-card">
        <span class="ffs-card-label">{{ section.settings.card_2_label | default: 'Chat with us' }}</span>
        <div class="ffs-card-actions">
          <a href="{{ section.settings.call_url | default: 'tel:+18005550199' }}" class="ffs-card-action-link">
            {{ section.settings.call_label | default: 'Call us' }}
          </a>
          <span class="ffs-card-action-sep">or</span>
          <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/18005550199' }}" class="ffs-card-action-link ffs-wa-link" target="_blank" rel="noopener">
            <svg class="ffs-wa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            {{ section.settings.whatsapp_label | default: 'Whatsapp' }}
          </a>
        </div>
        <span class="ffs-card-note">{{ section.settings.card_2_note | default: 'Fastest for anything already on the press' }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQs Footer Support",
  "settings": [
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#EA5B1B"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Still deciding?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not in there? Ask a person."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ten rolls and three cards, free, next working day. Or price a run right now it takes a minute and you don't need an account."
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot Image"
    },
    {
      "type": "range",
      "id": "mascot_width",
      "label": "Mascot Width (px)",
      "min": 140,
      "max": 320,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Contact Card 1 (Email)"
    },
    {
      "type": "text",
      "id": "card_1_label",
      "label": "Card 1 Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "card_1_email",
      "label": "Card 1 Email",
      "default": "hello@tapefox.com"
    },
    {
      "type": "text",
      "id": "card_1_note",
      "label": "Card 1 Note",
      "default": "One working day, usually less"
    },
    {
      "type": "header",
      "content": "Contact Card 2 (Chat / Call)"
    },
    {
      "type": "text",
      "id": "card_2_label",
      "label": "Card 2 Label",
      "default": "Chat with us"
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call Link Label",
      "default": "Call us"
    },
    {
      "type": "text",
      "id": "call_url",
      "label": "Call Link URL",
      "default": "tel:+18005550199"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp Link Label",
      "default": "Whatsapp"
    },
    {
      "type": "text",
      "id": "whatsapp_url",
      "label": "WhatsApp Link URL",
      "default": "https://wa.me/18005550199"
    },
    {
      "type": "text",
      "id": "card_2_note",
      "label": "Card 2 Note",
      "default": "Fastest for anything already on the press"
    }
  ],
  "presets": [
    {
      "name": "FAQs Footer Support"
    }
  ]
}
{% endschema %}
