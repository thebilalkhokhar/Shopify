{% doc %}
  Renders the desktop search dropdown panel.
  Opens on clicking the header search icon.
  Matches the sleek, rounded card design with a pills row for "POPULAR SEARCHES",
  real-time predictive search, and standard Shopify form action.

  @param {section} section - The parent header section
{% enddoc %}

<div class="header-search-menu" id="HeaderSearchMenu" aria-hidden="true">
  <div class="header-search-inner header-megamenu__inner">
    
    <!-- Search Bar Form -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      
      <div class="header-search__bar">
        <span class="header-search__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="1.8">
            <circle cx="11" cy="11" r="7.5"></circle>
            <path d="m20 20-3.8-3.8"></path>
          </svg>
        </span>
        <input
          type="search"
          name="q"
          id="HeaderSearchInput"
          class="header-search__input"
          placeholder="{{ section.settings.search_placeholder | default: 'Search tapes, specs, help' }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="button" class="header-search__clear" id="HeaderSearchClear" aria-label="Clear search" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </form>

    <!-- Popular Searches Section -->
    <div class="header-search__popular">
      <span class="header-search__popular-label">
        {{ section.settings.search_popular_label | default: 'POPULAR SEARCHES' }}
      </span>
      <div class="header-search__tags">
        {% assign default_tags = 'Paper tapes,Free Sample,Lead time' | split: ',' %}
        {% assign popular_tags_str = section.settings.search_popular_tags | default: 'Paper tapes,Free Sample,Lead time' %}
        {% assign popular_tags = popular_tags_str | split: ',' %}
        {% for tag in popular_tags %}
          {% assign tag_clean = tag | strip %}
          {% if tag_clean != blank %}
            <a href="{{ routes.search_url }}?q={{ tag_clean | url_encode }}&type=product" class="header-search__tag-pill">
              {{ tag_clean }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Live Predictive Search Results Container -->
    <div class="header-search__results" id="HeaderSearchResults" style="display: none;"></div>

  </div>
</div>
