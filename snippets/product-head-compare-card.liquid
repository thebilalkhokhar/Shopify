{% doc %}
  Renders a mobile product comparison card with its attribute values.

  @param {section} section - The parent comparison section
  @param {string} title - The product column title
  @param {string} value_key - The comparison block setting used for this product

  @example
  {% render 'product-head-compare-card', section: section, title: section.settings.col_1_title, value_key: 'poly_val' %}
{% enddoc %}

{%- assign card_title = title -%}
{%- if card_title == blank -%}
  {%- case value_key -%}
    {%- when 'poly_val' -%}
      {%- assign card_title = 'POLYPROPYLENE' -%}
    {%- when 'paper_val' -%}
      {%- assign card_title = 'PAPER' -%}
    {%- when 'pvc_val' -%}
      {%- assign card_title = 'PVC' -%}
  {%- endcase -%}
{%- endif -%}

<article class="phc-mobile-card{% if value_key == 'poly_val' %} phc-mobile-card--poly{% endif %}">
  <h3 class="phc-mobile-card-title">{{ card_title | escape }}</h3>

  <dl class="phc-mobile-card-details">
    {%- for block in section.blocks -%}
      {%- assign comparison_value = block.settings[value_key] | strip -%}
      <div class="phc-mobile-card-row">
        <dt>{{ block.settings.attribute_label | escape }}</dt>
        <dd>
          {%- if comparison_value == 'YES' or comparison_value == 'yes' or comparison_value == 'Yes' -%}
            <span class="phc-pill-tag phc-tag-yes">YES</span>
          {%- elsif comparison_value == 'NO' or comparison_value == 'no' or comparison_value == 'No' -%}
            <span class="phc-pill-tag phc-tag-no">NO</span>
          {%- else -%}
            {{ comparison_value | escape }}
          {%- endif -%}
        </dd>
      </div>
    {%- endfor -%}
  </dl>
</article>
