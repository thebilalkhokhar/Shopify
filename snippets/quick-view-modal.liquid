{% doc %}
  Renders the global Quick View Product Modal.
  Displays complete product configurator, order steps, price breakdown, and direct link to full PDP.
{% enddoc %}

<div id="TapefoxQuickViewModal" class="tf-qv-modal" aria-hidden="true" role="dialog" aria-modal="true" data-lenis-prevent>
  <div class="tf-qv-backdrop" id="TapefoxQuickViewBackdrop"></div>
  <div class="tf-qv-dialog">
    <!-- Close Button -->
    <button type="button" class="tf-qv-close" id="TapefoxQuickViewClose" aria-label="Close modal">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Scrollable Content -->
    <div class="tf-qv-body">
      <!-- Section 1: Main Product Configurator Grid -->
      <div class="tf-qv-top-grid">
        <!-- Left Column: Big Image & 4 Spec Cards -->
        <div class="tf-qv-left-col">
          <div class="tf-qv-image-card" id="tfQvImageCard">
            <span class="tf-qv-badge" id="tfQvBadge">Most Ordered</span>
            <div class="tf-qv-image-wrap">
              <img id="tfQvImage" src="" alt="Tape Product" width="550" height="420" loading="eager">
            </div>
          </div>

          <!-- 4 Spec Boxes 2x2 Grid -->
          <div class="tf-qv-specs-grid">
            <div class="tf-qv-spec-box">
              <span class="tf-qv-spec-label">SEAL UPTO</span>
              <p class="tf-qv-spec-val" id="tfQvSpecSeal">1.9 mil to 30 lbs · 2.5 mil to 50 lbs · 2.8 mil over 50 lbs</p>
            </div>
            <div class="tf-qv-spec-box">
              <span class="tf-qv-spec-label">GOES ON</span>
              <p class="tf-qv-spec-val" id="tfQvSpecGoes">Normal Tape gun</p>
            </div>
            <div class="tf-qv-spec-box">
              <span class="tf-qv-spec-label">TAMPER EVIDENT</span>
              <p class="tf-qv-spec-val" id="tfQvSpecTamper">No</p>
            </div>
            <div class="tf-qv-spec-box">
              <span class="tf-qv-spec-label">LEAD TIME</span>
              <p class="tf-qv-spec-val" id="tfQvSpecLead">Proof 2-3 days, ships in 3 weeks</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Product Configurator Form -->
        <div class="tf-qv-right-col">
          <div class="tf-qv-subhead" id="tfQvCategory">High-volume shipping</div>
          <h2 class="tf-qv-title" id="tfQvTitle">Polypropylene Tape</h2>
          <div class="tf-qv-price-subhead" id="tfQvPriceSubhead">
            Starting at <span class="tf-qv-price-val" id="tfQvPriceVal">$5.68 a roll</span>
          </div>
          <p class="tf-qv-desc" id="tfQvDesc">The default for corrugated cartons. Glossy, hot-melt, and cheap enough to brand every box that leaves the building.</p>

          <form method="post" action="/cart/add" id="tfQvForm" class="tf-qv-form">
            <input type="hidden" name="id" id="tfQvVariantId" value="">
            <input type="hidden" name="quantity" id="tfQvHiddenQuantity" value="">
            <input type="hidden" name="properties[Material]" id="tfQvPropMaterial" value="">
            <input type="hidden" name="properties[Width]" id="tfQvPropWidth" value="">
            <input type="hidden" name="properties[Length]" id="tfQvPropLength" value="">
            <input type="hidden" name="properties[Tape Color]" id="tfQvPropTapeColor" value="">
            <input type="hidden" name="properties[Inks]" id="tfQvPropInks" value="">
            <input type="hidden" name="properties[Ink Color]" id="tfQvPropInkColor" value="">
            <input type="hidden" name="properties[Coverage]" id="tfQvPropCoverage" value="">
            <input type="hidden" name="properties[Printed Before]" id="tfQvPropPrintedBefore" value="">
            <input type="hidden" name="properties[Cases]" id="tfQvPropCases" value="">
            <input type="hidden" name="properties[Rolls]" id="tfQvPropRolls" value="">
            <input type="hidden" name="properties[Total Price]" id="tfQvPropTotalPrice" value="">
            <input type="hidden" name="properties[Per Roll Price]" id="tfQvPropPerRollPrice" value="">
            <input type="hidden" name="properties[Artwork Option]" id="tfQvPropArtwork" value="">
            <input type="hidden" name="properties[Artwork File Name]" id="tfQvPropArtworkFileName" value="">
            <input type="hidden" name="properties[Artwork File Size]" id="tfQvPropArtworkFileSize" value="">

            <!-- 1. MATERIAL -->
            <div class="tf-qv-group">
              <label class="tf-qv-group-label">MATERIAL</label>
              <div class="tf-qv-pill-row" id="tfQvMaterialGroup">
                <button type="button" class="tf-qv-pill" data-group="material" data-val="Polypropylene" data-handle="polypropylene-tape">Polypropylene</button>
                <button type="button" class="tf-qv-pill" data-group="material" data-val="Paper" data-handle="paper-tape">Paper</button>
                <button type="button" class="tf-qv-pill" data-group="material" data-val="PVC" data-handle="pvc-tape">PVC</button>
                <button type="button" class="tf-qv-pill" data-group="material" data-val="Hi-Track Freezer" data-handle="hi-tack-freezer-tape">Hi-Track Freezer</button>
                <button type="button" class="tf-qv-pill" data-group="material" data-val="Flat back" data-handle="flatback-tape">Flat back</button>
              </div>
            </div>

            <!-- 2. WIDTH -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">WIDTH</label>
              <div class="tf-qv-pill-row" id="tfQvWidthGroup">
                <button type="button" class="tf-qv-pill" data-group="width" data-val="2 inch">2 inch</button>
                <button type="button" class="tf-qv-pill" data-group="width" data-val="3 inch">3 inch</button>
              </div>
            </div>

            <!-- 3. LENGTH -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">LENGTH</label>
              <div class="tf-qv-pill-row" id="tfQvLengthGroup">
                <button type="button" class="tf-qv-pill" data-group="length" data-val="375 feet">375 feet</button>
                <button type="button" class="tf-qv-pill" data-group="length" data-val="450 feet">450 feet</button>
                <button type="button" class="tf-qv-pill" data-group="length" data-val="500 feet">500 feet</button>
              </div>
            </div>

            <!-- 4. TAPE COLOR -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">TAPE COLOR</label>
              <div class="tf-qv-pill-row" id="tfQvTapeColorGroup">
                <button type="button" class="tf-qv-pill tf-qv-pill--color" data-group="tape_color" data-val="White">
                  <span class="tf-qv-color-dot" style="background-color: #FFFFFF; border: 1px solid #D5D0C7;"></span>
                  <span>White</span>
                </button>
                <button type="button" class="tf-qv-pill tf-qv-pill--color" data-group="tape_color" data-val="Tan/Kraft">
                  <span class="tf-qv-color-dot" style="background-color: #D3A77C;"></span>
                  <span>Tan/Kraft</span>
                </button>
              </div>
            </div>

            <!-- 5. INKS -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">INKS</label>
              <div class="tf-qv-pill-row" id="tfQvInksGroup">
                <button type="button" class="tf-qv-pill" data-group="inks" data-val="One ink">One ink . 5 case min</button>
                <button type="button" class="tf-qv-pill" data-group="inks" data-val="Two ink">Two ink . 5 case min</button>
                <button type="button" class="tf-qv-pill" data-group="inks" data-val="Three ink">Three ink . 5 case min</button>
              </div>
            </div>

            <!-- 6. INKS COLORS SWATCHES -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">INKS COLORS</label>
              <div class="tf-qv-swatches-row" id="tfQvSwatchesRow">
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Black" aria-label="Black" style="--swatch-c: #171008;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="White" aria-label="White" style="--swatch-c: #FFFFFF; border: 1.5px solid #bbb;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Blue" aria-label="Blue" style="--swatch-c: #1F50A5;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Red" aria-label="Red" style="--swatch-c: #D72C0D;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Green" aria-label="Green" style="--swatch-c: #1E824C;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Orange" aria-label="Orange" style="--swatch-c: #FE6A00;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Yellow" aria-label="Yellow" style="--swatch-c: #F8B825;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Brown" aria-label="Brown" style="--swatch-c: #6F4E37;"></button>
                <button type="button" class="tf-qv-swatch" data-group="ink_color" data-val="Grey" aria-label="Grey" style="--swatch-c: #7D7D7D;"></button>
              </div>
            </div>

            <!-- 7. COVERAGE -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">COVERAGE</label>
              <div class="tf-qv-pill-row" id="tfQvCoverageGroup">
                <button type="button" class="tf-qv-pill" data-group="coverage" data-val="Standard">Standard</button>
                <button type="button" class="tf-qv-pill" data-group="coverage" data-val="Reverse/flood coat">Reverse/flood coat</button>
              </div>
            </div>

            <!-- 8. HAVE WE PRINTED THIS ARTWORK BEFORE? -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">HAVE WE PRINTED THIS ARTWORK BEFORE?</label>
              <div class="tf-qv-pill-row" id="tfQvPrintedBeforeGroup">
                <button type="button" class="tf-qv-pill" data-group="printed_before" data-val="No - New design">No - New design</button>
                <button type="button" class="tf-qv-pill" data-group="printed_before" data-val="Yes - Reprint">Yes - Reprint</button>
              </div>
            </div>

            <!-- 9. CASE -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">CASE</label>
              <div class="tf-qv-cases-row">
                <div class="tf-qv-stepper">
                  <button type="button" class="tf-qv-stepper-btn" id="tfQvQtyMinus" aria-label="Decrease quantity">−</button>
                  <span class="tf-qv-stepper-val" id="tfQvQtyDisplay">—</span>
                  <button type="button" class="tf-qv-stepper-btn" id="tfQvQtyPlus" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="tf-qv-case-preset" data-cases="5">5</button>
                <button type="button" class="tf-qv-case-preset" data-cases="10">10</button>
                <button type="button" class="tf-qv-case-preset" data-cases="25">25</button>
                <button type="button" class="tf-qv-case-preset" data-cases="50">50</button>
                <button type="button" class="tf-qv-case-preset" data-cases="64">64</button>
              </div>
            </div>

            <!-- 10. ARTWORK -->
            <div class="tf-qv-group tf-qv-divider">
              <label class="tf-qv-group-label">ARTWORK</label>
              <div class="tf-qv-artwork-list">
                <!-- Option 1: Upload now -->
                <div class="tf-qv-artwork-card-wrapper">
                  <label class="tf-qv-art-card" data-artwork="Upload now" id="tfQvArtworkCardUpload">
                    <input type="radio" name="tf_qv_art_choice" value="Upload now">
                    <span class="tf-qv-radio-disc"></span>
                    <div class="tf-qv-art-content">
                      <span class="tf-qv-art-title">Upload now</span>
                      <span class="tf-qv-art-sub">PDF, AI or EPS , upto 20 MB</span>
                    </div>
                  </label>
                  <input
                    type="file"
                    id="tfQvArtworkFileInput"
                    name="properties[Artwork Files][]"
                    accept=".pdf,.ai,.eps,.png,.jpg,.jpeg,.svg"
                    multiple
                    style="display: none;"
                  >
                  <!-- Dynamic Uploaded Files List -->
                  <div class="tf-qv-uploaded-files-list" id="tfQvUploadedFilesList" style="display: none;"></div>
                </div>

                <!-- Option 2: Send it after checkout -->
                <label class="tf-qv-art-card" data-artwork="Send it after checkout">
                  <input type="radio" name="tf_qv_art_choice" value="Send it after checkout">
                  <span class="tf-qv-radio-disc"></span>
                  <div class="tf-qv-art-content">
                    <span class="tf-qv-art-title">Send it after checkout</span>
                    <span class="tf-qv-art-sub">We email you a link the moment your order</span>
                  </div>
                </label>

                <!-- Option 3: Design it for us -->
                <label class="tf-qv-art-card" data-artwork="Design it for us">
                  <input type="radio" name="tf_qv_art_choice" value="Design it for us">
                  <span class="tf-qv-radio-disc"></span>
                  <div class="tf-qv-art-content">
                    <span class="tf-qv-art-title">Design it for us</span>
                    <span class="tf-qv-art-sub">Send a logo and rough idea - Free design support</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Orange Proof Notice -->
            <div class="tf-qv-proof-notice">Whichever you pick, we send a proof before the press runs.</div>

            <!-- Dark Summary Strip -->
            <div class="tf-qv-summary-strip">
              <div class="tf-qv-sum-col">
                <span class="tf-qv-sum-lbl">Total cases</span>
                <span class="tf-qv-sum-val" id="tfQvSummaryCases">—</span>
              </div>
              <div class="tf-qv-sum-col">
                <span class="tf-qv-sum-lbl">Total rolls</span>
                <span class="tf-qv-sum-val" id="tfQvSummaryRolls">—</span>
              </div>
              <div class="tf-qv-sum-col tf-qv-sum-col--right">
                <span class="tf-qv-sum-lbl">Price per case</span>
                <span class="tf-qv-sum-val" id="tfQvSummaryPricePerCase">—</span>
              </div>
            </div>

            <!-- Total Price Row -->
            <div class="tf-qv-total-row">
              <div class="tf-qv-total-lbl">Total</div>
              <div class="tf-qv-total-block">
                <div class="tf-qv-total-price" id="tfQvTotalPrice">—</div>
                <div class="tf-qv-per-roll-price" id="tfQvPerRollPrice">Select options to calculate</div>
              </div>
            </div>

            <!-- Yellow Capsule Add to Cart -->
            <button type="submit" class="tf-qv-add-to-cart-btn" id="tfQvAddToCartBtn">Add to cart</button>
          </form>
        </div>
      </div>

      <!-- Section 2: What happens after you order -->
      <div class="tf-qv-order-steps">
        <h3 class="tf-qv-steps-heading">What happens after you order</h3>
        <div class="tf-qv-steps-grid">
          <div class="tf-qv-step-card">
            <div class="tf-qv-step-top">
              <span class="tf-qv-num-badge">01</span>
              <div class="tf-qv-step-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </div>
            </div>
            <h4 class="tf-qv-step-title">Order it</h4>
            <p class="tf-qv-step-text">Your spec is locked in and the case price is fixed at what you saw.</p>
            <div class="tf-qv-step-footer">
              <span class="tf-qv-status-pill">Today</span>
            </div>
          </div>

          <div class="tf-qv-step-card">
            <div class="tf-qv-step-top">
              <span class="tf-qv-num-badge">02</span>
              <div class="tf-qv-step-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 16l-4-4-4 4"></path>
                  <path d="M12 12v9"></path>
                  <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path>
                </svg>
              </div>
            </div>
            <h4 class="tf-qv-step-title">Artwork</h4>
            <p class="tf-qv-step-text">Upload now, mail it over after, or send a logo and let us draw it.</p>
            <div class="tf-qv-step-footer">
              <span class="tf-qv-status-pill">Whenever suits</span>
            </div>
          </div>

          <div class="tf-qv-step-card">
            <div class="tf-qv-step-top">
              <span class="tf-qv-num-badge">03</span>
              <div class="tf-qv-step-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
            </div>
            <h4 class="tf-qv-step-title">Proof, then print</h4>
            <p class="tf-qv-step-text">We send it back for approval. Nothing goes on the press until you say yes.</p>
            <div class="tf-qv-step-footer">
              <span class="tf-qv-status-pill">2-3 working days</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 3: General pricing chart -->
      <div class="tf-qv-pricing-chart">
        <h3 class="tf-qv-pricing-title">General pricing chart</h3>
        <p class="tf-qv-pricing-sub" id="tfQvPricingSub">Polypropylene · 3 inch × 375 feet · one ink · 8 rolls a case · tap a row to set it</p>
        <div class="tf-qv-table-card">
          <table class="tf-qv-table">
            <thead>
              <tr>
                <th>CASES</th>
                <th>ROLLS</th>
                <th>PER CASE</th>
                <th>TAPE</th>
                <th>TOTAL</th>
                <th>PER ROLL</th>
              </tr>
            </thead>
            <tbody id="tfQvTableBody">
              <tr data-cases="5">
                <td>5</td>
                <td>40</td>
                <td>$82.93</td>
                <td>$414.63</td>
                <td>$464.63</td>
                <td class="tf-qv-col-orange">$11.62</td>
              </tr>
              <tr data-cases="10">
                <td>10</td>
                <td>80</td>
                <td>$71.72</td>
                <td>$717.22</td>
                <td>$767.22</td>
                <td class="tf-qv-col-orange">$9.59</td>
              </tr>
              <tr data-cases="25">
                <td>25</td>
                <td>200</td>
                <td>$57.06</td>
                <td>$1476.62</td>
                <td>$1476.62</td>
                <td class="tf-qv-col-orange">$7.38</td>
              </tr>
              <tr data-cases="50">
                <td>50</td>
                <td>400</td>
                <td>$51.07</td>
                <td>$2,553.47</td>
                <td>$2,603.47</td>
                <td class="tf-qv-col-orange">$6.51</td>
              </tr>
              <tr data-cases="64">
                <td>64</td>
                <td>512</td>
                <td>$44.66</td>
                <td>$2,858.55</td>
                <td>$2,908.55</td>
                <td class="tf-qv-col-orange">$5.68</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 4: Orange Bottom Link Bar to PDP page -->
      <a href="#" class="tf-qv-bottom-banner" id="tfQvFullPdpLink">
        <div class="tf-qv-banner-left">
          <span class="tf-qv-banner-tag">On the full page</span>
          <span class="tf-qv-banner-sub">How it compares with the other four, who buys it, the guides and the reviews.</span>
        </div>
        <div class="tf-qv-banner-right">
          <span>Full details</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>
  </div>
</div>
