<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  if request.path contains '/products/'
    assign p_handle = request.path | split: '/products/' | last | split: '/' | first | split: '?' | first
    case p_handle
      when 'paper-tape'
        assign og_title = 'Paper Tape – Custom Printed Kraft Tape'
        assign og_description = 'Custom printed Paper Tape. Eco-friendly, water-activated kraft paper tape printed with your artwork up to 3 inks. Free design support & shipping.'
      when 'pvc-tape'
        assign og_title = 'PVC Tape – Heavy Duty Packaging Tape'
        assign og_description = 'Custom printed PVC Tape. Ultra-quiet release and superior adhesion for heavy-duty cartons and cold storage.'
      when 'hi-tack-freezer-tape'
        assign og_title = 'Hi-Tack Freezer Tape – Cold Chain Packaging'
        assign og_description = 'Hi-Tack Freezer Tape engineered for extreme cold temperatures, frozen goods, and food packaging.'
      when 'flatback-tape'
        assign og_title = 'Flatback Tape – Strong Kraft Paper Tape'
        assign og_description = 'Custom Flatback paper tape. Hand-tearable, high-tack adhesive for fast carton sealing and tabbing.'
      when 'dispensers'
        assign og_title = 'Tape Dispensers – Heavy-Duty Dispensers'
        assign og_description = 'Industrial-grade tape guns and water-activated tape dispensers for fast, efficient warehouse shipping.'
      when 'polypropylene-tape'
        assign og_title = 'Polypropylene Tape – Custom Printed Carton Tape'
        assign og_description = 'The default for corrugated cartons. Glossy, hot-melt, and cheap enough to brand every box that leaves the building.'
      else
        if product.title != blank
          assign og_title = product.title
          assign og_description = product.description | strip_html | truncate: 160
        endif
    endcase
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {%- if request.path contains '/products/' and og_title != blank -%}
    {{ og_title }} &ndash; {{ shop.name }}
  {%- else -%}
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- endif -%}

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- assign meta_description = og_description | default: page_description | default: shop.description -%}
{%- if meta_description != blank -%}
  <meta
    name="description"
    content="{{ meta_description | strip_html | strip_newlines | truncate: 160 | escape }}"
  >
{%- endif -%}
